{
  "name": "japan-it-ai-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "security:check": "node scripts/check-csp.mjs",
    "bilingual:sync-interview": "node scripts/sync-bilingual-interview.mjs",
    "bilingual:check-interview": "node scripts/sync-bilingual-interview.mjs --check",
    "quality:check": "node scripts/validate-daily-quality.mjs",
    "quality:check:latest": "node scripts/validate-daily-quality.mjs --date=$(date +%F)",
    "audio:check": "node --check scripts/audio-cache.mjs && node --check scripts/learning-audio-plan.mjs && node --check scripts/generate-japanese-audio.mjs && node --check scripts/generate-interview-audio.mjs && node --check scripts/validate-interview-audio-duration.mjs && node --check scripts/strip-dist-audio.mjs && node --check scripts/validate-daily-quality.mjs && node --check scripts/audit-r2-audio-orphans.mjs && node --check scripts/audio-file-versions.mjs && node --check scripts/backfill-audio-versions.mjs && node --check scripts/audio-manifest-state.mjs && node --check scripts/audio-publication.mjs && node --check scripts/stage-audio-publication.mjs && node --check scripts/remote-audio.mjs && node --check scripts/verify-audio-integrity.mjs",
    "audio:strip-dist": "node scripts/strip-dist-audio.mjs",
    "audio:duration:check": "node scripts/validate-interview-audio-duration.mjs --from 2026-08-12",
    "audio:duration:write:latest": "node scripts/validate-interview-audio-duration.mjs --latest --write",
    "audio:duration:backfill": "node scripts/validate-interview-audio-duration.mjs --all --write",
    "audio:generate": "node scripts/generate-japanese-audio.mjs && node scripts/generate-interview-audio.mjs && node scripts/validate-interview-audio-duration.mjs --latest --write",
    "audio:generate:latest": "node scripts/generate-japanese-audio.mjs --latest && node scripts/generate-interview-audio.mjs --latest && node scripts/validate-interview-audio-duration.mjs --latest --write",
    "audio:generate:all": "node scripts/generate-japanese-audio.mjs --all && node scripts/generate-interview-audio.mjs --all && node scripts/validate-interview-audio-duration.mjs --all --write",
    "audio:generate:all:force": "node scripts/generate-japanese-audio.mjs --all --force && node scripts/generate-interview-audio.mjs --all --force && node scripts/validate-interview-audio-duration.mjs --all --write",
    "audio:generate:interview:latest": "node scripts/generate-interview-audio.mjs --latest && node scripts/validate-interview-audio-duration.mjs --latest --write",
    "audio:generate:interview:all": "node scripts/generate-interview-audio.mjs --all && node scripts/validate-interview-audio-duration.mjs --all --write",
    "audio:generate:interview:all:force": "node scripts/generate-interview-audio.mjs --all --force && node scripts/validate-interview-audio-duration.mjs --all --write",
    "audio:integrity:check": "node scripts/verify-audio-integrity.mjs",
    "audio:versions:write": "node scripts/backfill-audio-versions.mjs",
    "audio:versions:check": "node scripts/backfill-audio-versions.mjs --check",
    "test:browser": "playwright test",
    "content:integrity:check": "node scripts/validate-content-integrity.mjs && npm run jlpt:check && npm run grammar:check && npm run study:check && npm run interview:check",
    "evidence:init": "node scripts/init-source-evidence.mjs",
    "evidence:check": "node scripts/validate-source-evidence.mjs",
    "evidence:pilot": "node scripts/validate-source-evidence.mjs --pilot docs/evidence/pilot-2026-09-07.json",
    "jlpt:check": "node scripts/check-jlpt-history.mjs",
    "grammar:check": "node scripts/check-grammar-history.mjs",
    "study:check": "node scripts/check-study-review.mjs",
    "interview:check": "node scripts/validate-structured-interviews.mjs",
    "interview:render": "node scripts/render-interview-sections.mjs",
    "deployment:prepare": "node scripts/verify-deployment.mjs --prepare dist",
    "deployment:verify": "node scripts/verify-deployment.mjs",
    "test:browser:speech-smoke": "playwright test tests/browser/speech-smoke.spec.ts"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "astro": "7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "yaml": "2.9.0"
  }
}
