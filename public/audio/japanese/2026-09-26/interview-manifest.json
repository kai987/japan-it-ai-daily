    {
      "index": 2,
      "type": "question",
      "text": "UnityのMeta VR Glasses対応を、発売前の開発計画にどう取り入れますか。",
      "audio": "interview-question-02.mp3",
      "audioHash": "6f3cdec8e843fc281bbd2b21259bab31c11e5389831941d79039d0aa2b97aa2d",
