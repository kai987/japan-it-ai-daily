      "durationStatus": "ideal"
    },
    {
      "index": 2,
      "type": "question",
      "text": "GPUを複数のコンテナで共有する際、何を確認しますか。",
      "audio": "interview-question-02.mp3",
      "audioHash": "bbbfd8d9fc7802bc3d7f8484fa358d0bb3cdde708b380fb90566f6b8cb128045",
