      "durationSeconds": 23.555,
      "durationStatus": "warn"
    },
    {
      "index": 5,
      "type": "question",
      "text": "既存のLinuxソフトをWebAssemblyへ移すとき、何を調べますか。",
      "audio": "interview-question-05.mp3",
      "audioHash": "48933eb7098a6edcd73b6973f8ab40ea170a307a37b7ed7042e06417fd450b38",
