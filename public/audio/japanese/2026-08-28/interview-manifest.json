    {
      "index": 1,
      "type": "question",
      "text": "AIエージェントからのWebアクセスを、どう観測しますか。",
      "audio": "interview-question-01.mp3",
      "audioHash": "7d82f72521ff624eb7b3f8d7ae81d659bd04a92b85d84555344ed337d87bb5c4",
