    {
      "index": 2,
      "type": "question",
      "text": "AI編集機能を設計するとき、YouTubeの会話型編集から何を学べますか。",
      "audio": "interview-question-02.mp3",
      "audioHash": "d03686c9f1b39fad7db050bc583d3b1718dcf71d55ad4c1158749d30daa2e49f",
