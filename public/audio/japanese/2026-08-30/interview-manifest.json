  "interview": [
    {
      "index": 1,
      "type": "question",
      "text": "LLMによるレビューが信頼できるか、どう評価しますか。",
      "audio": "interview-question-01.mp3",
      "audioHash": "6e2595be4b57130cfb52813d516dbbd01208d96c8eea91415e584a35708ee88e",
