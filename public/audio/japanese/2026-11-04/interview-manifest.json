    {
      "index": 1,
      "type": "question",
      "text": "話者分離で二人の発言が一人にまとまったとき、どこから調べますか。",
      "audio": "interview-question-01.mp3",
      "audioHash": "70bbf16d0474b3d4c39e9990b25eabef0440d895c7435779413b0ce966a87c2b",
