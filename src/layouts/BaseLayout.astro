---
import '../styles/global.css';
const { title = 'Japan IT / AI Daily', description = '日本のIT・AI技術ニュースを、面接対策と技術日本語の視点から毎日整理。' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={base}><span>J</span>apan IT / AI Daily</a>
        <nav class="nav-links" aria-label="Primary">
          <a href={base}>Daily</a>
          <a href={`${base}topics/`}>Topics</a>
          <a href={`${base}interview/`}>Interview</a>
          <a href={`${base}japanese/`}>日本語</a>
          <a href={`${base}archive/`}>Archive</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="container">Japan IT / AI Daily · 日本のIT/AIニュース、面接対策、技術日本語を毎日整理。</div>
    </footer>
  </body>
</html>
