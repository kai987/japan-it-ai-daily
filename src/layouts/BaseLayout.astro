---
import '../styles/global.css';
import '../styles/prism.css';
import '../styles/topics.css';
import '../styles/responsive.css';
import '../styles/pagination.css';
import '../styles/speech.css';
import SiteSearch from '../components/SiteSearch.astro';
import MermaidRenderer from '../components/MermaidRenderer.astro';
import InterviewStaticAudio from '../components/InterviewStaticAudio.astro';
import SearchDeepLink from '../components/SearchDeepLink.astro';
import { DEFAULT_LOCALE, localeRoot, type SiteLocale } from '../lib/locale';

const {
  title = 'Japan IT / AI Daily',
  description = '日本のIT・AI技術ニュースを、面接対策と技術日本語の視点から毎日整理。',
  locale = 'zh',
} = Astro.props as { title?: string; description?: string; locale?: SiteLocale };
const base = import.meta.env.BASE_URL;
const localizedBase = localeRoot(base, locale);
const navLabels = locale === 'ja'
  ? { daily: '日報', topics: 'トピック', interview: '面接', japanese: '日本語', archive: 'アーカイブ' }
  : { daily: 'Daily', topics: 'Topics', interview: 'Interview', japanese: '日本語', archive: 'Archive' };
---
<!doctype html>
<html lang={locale === 'ja' ? 'ja' : 'zh-CN'} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <script is:inline define:vars={{ base, locale, defaultLocale: DEFAULT_LOCALE }}>
      (() => {
        const storedLanguage = localStorage.getItem('site-language');
        const shouldDefaultToJapanese = locale === 'zh' && (
          storedLanguage === 'ja' ||
          (storedLanguage !== 'zh' && defaultLocale === 'ja')
        );
        if (!shouldDefaultToJapanese) return;

        const normalizedBase = base.endsWith('/') ? base : `${base}/`;
        const pathname = window.location.pathname;
        const relative = pathname.startsWith(normalizedBase)
          ? pathname.slice(normalizedBase.length)
          : pathname.replace(/^\/+/, '');
        const withoutJa = relative.replace(/^ja\//, '');
        const nextPath = `${normalizedBase}ja/${withoutJa}`;
        window.location.replace(`${nextPath}${window.location.search}${window.location.hash}`);
      })();
    </script>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored === 'light' || stored === 'dark' ? stored : (systemDark ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={localizedBase}><span>J</span>apan IT / AI Daily</a>
        <SiteSearch locale={locale} />
        <div class="nav-actions">
          <nav class="nav-links" id="primary-nav" aria-label="Primary">
            <a href={localizedBase}>{navLabels.daily}</a>
            <a href={`${localizedBase}topics/`}>{navLabels.topics}</a>
            <a href={`${localizedBase}interview/`}>{navLabels.interview}</a>
            <a href={`${localizedBase}japanese/`}>{navLabels.japanese}</a>
            <a href={`${localizedBase}archive/`}>{navLabels.archive}</a>
          </nav>
          <label class="language-switcher" title={locale === 'ja' ? '表示言語を切り替える' : '切换显示语言'}>
            <span class="sr-only">{locale === 'ja' ? '表示言語' : '显示语言'}</span>
            <select
              class="language-select"
              aria-label={locale === 'ja' ? '表示言語' : '显示语言'}
              data-base={base}
              data-current-locale={locale}
              data-default-locale={DEFAULT_LOCALE}
            >
              <option value="ja" selected={locale === 'ja'}>日本語</option>
              <option value="zh" selected={locale === 'zh'}>中文</option>
            </select>
          </label>
          <button class="theme-toggle" type="button" aria-label="ダークモードに切り替える" title="テーマを切り替える">
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
            </svg>
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.4 15.2A8.5 8.5 0 0 1 8.8 3.6 8.5 8.5 0 1 0 20.4 15.2Z"></path>
            </svg>
          </button>
          <button class="mobile-menu-toggle" type="button" aria-label="メニューを開く" aria-controls="primary-nav" aria-expanded="false">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 7h14M5 12h14M5 17h14"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="container">Japan IT / AI Daily · 日本のIT/AIニュース、面接対策、技術日本語を毎日整理。</div>
    </footer>

    <script>
      (() => {
        const select = document.querySelector('.language-select');
        if (!(select instanceof HTMLSelectElement)) return;
        select.addEventListener('change', () => {
          const next = select.value === 'ja' ? 'ja' : 'zh';
          const base = select.dataset.base || '/';
          const normalizedBase = base.endsWith('/') ? base : `${base}/`;
          const pathname = window.location.pathname;
          const relative = pathname.startsWith(normalizedBase)
            ? pathname.slice(normalizedBase.length)
            : pathname.replace(/^\/+/, '');
          const withoutJa = relative.replace(/^ja\//, '');
          const nextPath = next === 'ja'
            ? `${normalizedBase}ja/${withoutJa}`
            : `${normalizedBase}${withoutJa}`;
          localStorage.setItem('site-language', next);
          window.location.assign(`${nextPath}${window.location.search}${window.location.hash}`);
        });
      })();
    </script>

    <script is:inline>
      (() => {
        const button = document.querySelector('.theme-toggle');
        if (!(button instanceof HTMLButtonElement)) return;
        const syncLabel = () => {
          const dark = document.documentElement.dataset.theme === 'dark';
          button.setAttribute('aria-label', dark ? 'ライトモードに切り替える' : 'ダークモードに切り替える');
        };
        syncLabel();
        button.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
          syncLabel();
        });
      })();

      (() => {
        const button = document.querySelector('.mobile-menu-toggle');
        const nav = document.querySelector('.nav-links');
        if (!(button instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;
        const setOpen = (open) => {
          nav.classList.toggle('is-open', open);
          button.setAttribute('aria-expanded', String(open));
          button.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
          document.documentElement.classList.toggle('nav-open', open);
        };
        button.addEventListener('click', (event) => {
          event.stopPropagation();
          setOpen(!nav.classList.contains('is-open'));
        });
        nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
        document.addEventListener('click', (event) => {
          if (!nav.classList.contains('is-open')) return;
          const target = event.target;
          if (target instanceof Node && !nav.contains(target) && !button.contains(target)) setOpen(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setOpen(false);
        });
        window.matchMedia('(min-width: 801px)').addEventListener('change', (event) => {
          if (event.matches) setOpen(false);
        });
      })();

      (() => {
        const desktopToc = document.querySelector('.report-layout > .toc');
        const layout = document.querySelector('.report-layout');
        const article = layout?.querySelector('article');
        if (!(desktopToc instanceof HTMLElement) || !(layout instanceof HTMLElement) || !(article instanceof HTMLElement)) return;

        const sourceLinks = Array.from(desktopToc.querySelectorAll('a[href^="#"]'));
        if (!sourceLinks.length) return;

        const mobileToc = document.createElement('details');
        mobileToc.className = 'mobile-toc';
        const summary = document.createElement('summary');
        summary.innerHTML = '<span class="mobile-toc-label">目次</span><span class="mobile-toc-current">現在位置</span><span class="mobile-toc-chevron" aria-hidden="true"></span>';
        const mobileNav = document.createElement('nav');
        mobileNav.className = 'mobile-toc-links';
        mobileNav.setAttribute('aria-label', 'Mobile table of contents');
        sourceLinks.forEach((link) => {
          const clone = link.cloneNode(true);
          if (clone instanceof HTMLAnchorElement) mobileNav.appendChild(clone);
        });
        mobileToc.append(summary, mobileNav);
        layout.insertBefore(mobileToc, article);

        const allLinks = Array.from(document.querySelectorAll('.toc a[href^="#"], .mobile-toc a[href^="#"]'));
        const seen = new Set();
        const targets = sourceLinks
          .map((link) => {
            const href = link.getAttribute('href') || '';
            const id = href.startsWith('#') ? decodeURIComponent(href.slice(1)) : '';
            if (!id || seen.has(id)) return null;
            const element = document.getElementById(id);
            if (!(element instanceof HTMLElement)) return null;
            seen.add(id);
            return { id, element };
          })
          .filter((target) => target !== null);

        if (!targets.length) return;
        const currentLabel = mobileToc.querySelector('.mobile-toc-current');
        let activeId = '';

        const setActive = (id) => {
          if (!id || id === activeId) return;
          activeId = id;
          let activeText = '';
          allLinks.forEach((link) => {
            const href = link.getAttribute('href') || '';
            const linkId = href.startsWith('#') ? decodeURIComponent(href.slice(1)) : '';
            const active = linkId === id;
            link.classList.toggle('is-active', active);
            if (active) {
              link.setAttribute('aria-current', 'location');
              activeText = link.textContent?.trim() || activeText;
            } else {
              link.removeAttribute('aria-current');
            }
          });
          if (currentLabel instanceof HTMLElement && activeText) currentLabel.textContent = activeText;
          const activeDesktop = desktopToc.querySelector('a.is-active');
          if (activeDesktop instanceof HTMLElement && desktopToc.scrollHeight > desktopToc.clientHeight) {
            const desired = activeDesktop.offsetTop - desktopToc.clientHeight / 2 + activeDesktop.offsetHeight / 2;
            desktopToc.scrollTo({ top: Math.max(0, desired), behavior: 'smooth' });
          }
        };

        let ticking = false;
        const updateActive = () => {
          ticking = false;
          const offset = window.innerWidth <= 800 ? 118 : 124;
          let current = targets[0];
          for (const target of targets) {
            if (target.element.getBoundingClientRect().top <= offset) current = target;
            else break;
          }
          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8) current = targets[targets.length - 1];
          setActive(current.id);
        };
        const requestUpdate = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(updateActive);
        };

        allLinks.forEach((link) => {
          link.addEventListener('click', () => {
            const href = link.getAttribute('href') || '';
            const id = href.startsWith('#') ? decodeURIComponent(href.slice(1)) : '';
            if (id) setActive(id);
            if (mobileToc.open) mobileToc.open = false;
            setTimeout(requestUpdate, 180);
          });
        });
        window.addEventListener('scroll', requestUpdate, { passive: true });
        window.addEventListener('resize', requestUpdate);
        window.addEventListener('hashchange', requestUpdate);
        requestUpdate();
      })();
    </script>
    <MermaidRenderer />
    <InterviewStaticAudio />
    <SearchDeepLink />
  </body>
</html>