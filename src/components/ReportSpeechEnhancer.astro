<script>
  const article = document.querySelector('.report-layout article.prose');

  if (article instanceof HTMLElement) {
    const makeButton = (text: string, label: string): HTMLButtonElement => {
      const button = document.createElement('button');
      button.className = 'speech-button report-speech-button';
      button.type = 'button';
      button.dataset.speech = text;
      button.dataset.speechKind = 'interview';
      button.setAttribute('aria-label', label);
      button.setAttribute('aria-pressed', 'false');
      button.title = '日本語で読み上げる';
      button.innerHTML = `
        <svg class="speech-icon-speaker" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M11 5 7 9H4v6h3l4 4V5Z"></path>
          <path d="M15 9.5a4 4 0 0 1 0 5M17.5 7a7.3 7.3 0 0 1 0 10"></path>
        </svg>
        <svg class="speech-icon-stop" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="7" y="7" width="10" height="10" rx="1"></rect>
        </svg>`;
      return button;
    };

    const sectionNodes = (heading: HTMLHeadingElement): Element[] => {
      const nodes: Element[] = [];
      let node = heading.nextElementSibling;
      while (node && node.tagName !== 'H1' && node.tagName !== 'H2') {
        nodes.push(node);
        node = node.nextElementSibling;
      }
      return nodes;
    };

    const blockquotesFrom = (nodes: Element[]): HTMLQuoteElement[] => {
      const quotes: HTMLQuoteElement[] = [];
      for (const node of nodes) {
        if (node instanceof HTMLQuoteElement) quotes.push(node);
        node.querySelectorAll('blockquote').forEach((quote) => {
          if (quote instanceof HTMLQuoteElement) quotes.push(quote);
        });
      }
      return Array.from(new Set(quotes));
    };

    const enhanceElement = (target: HTMLElement, kind: 'interview' | 'review'): void => {
      if (target.dataset.speechEnhanced === 'true') return;
      const text = (target.textContent || '').replace(/\s+/g, ' ').trim();
      if (!text) return;

      target.dataset.speechEnhanced = 'true';
      target.classList.add('report-speech-target');
      const label = kind === 'review'
        ? '面接復習の質問を読み上げる'
        : '面接内容を読み上げる';
      target.insertBefore(makeButton(text, label), target.firstChild);
    };

    const enhanceLegacyQuotes = (nodes: Element[], kind: 'interview' | 'review'): number => {
      const quotes = blockquotesFrom(nodes);
      quotes.forEach((quote) => enhanceElement(quote, kind));
      return quotes.length;
    };

    const nextPlainParagraph = (label: Element): HTMLParagraphElement | null => {
      let node = label.nextElementSibling;
      while (node) {
        if (node.tagName === 'P') return node as HTMLParagraphElement;
        if (/^H[1-6]$/.test(node.tagName)) return null;
        node = node.nextElementSibling;
      }
      return null;
    };

    const headings = Array.from(article.querySelectorAll('h2'));
    const interviewHeading = headings.find((heading) =>
      (heading.textContent || '').includes('面接で使えるポイント'));

    if (interviewHeading instanceof HTMLHeadingElement) {
      const nodes = sectionNodes(interviewHeading);
      const quoteCount = enhanceLegacyQuotes(nodes, 'interview');

      // Current source-of-truth reports keep canonical questions/answers as plain
      // paragraphs so the Japanese strings can be copied byte-for-byte between
      // language modes. Legacy reports use blockquotes. Only use this path when
      // the section contains no quotes to avoid duplicate speech controls.
      if (quoteCount === 0) {
        for (const node of nodes) {
          if (!(node instanceof HTMLParagraphElement)) continue;
          const label = (node.textContent || '').replace(/\s+/g, ' ').trim();
          if (!/(?:面试问题|面接質問|約30秒回答|约30秒回答)/.test(label)) continue;
          const target = nextPlainParagraph(node);
          if (target) enhanceElement(target, 'interview');
        }
      }
    }

    const reviewHeading = headings.find((heading) => {
      const text = heading.textContent || '';
      return text.includes('面接復習カード') || text.includes('面试复习卡');
    });

    if (reviewHeading instanceof HTMLHeadingElement) {
      const nodes = sectionNodes(reviewHeading);
      const quoteCount = enhanceLegacyQuotes(nodes, 'review');

      if (quoteCount === 0) {
        for (const node of nodes) {
          if (!(node instanceof HTMLHeadingElement) || !/^H[3-6]$/.test(node.tagName)) continue;
          if (!/^Q\s*\d+/i.test((node.textContent || '').trim())) continue;
          const target = nextPlainParagraph(node);
          if (target) enhanceElement(target, 'review');
        }
      }
    }
  }
</script>
