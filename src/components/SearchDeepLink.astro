<script>
  (() => {
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest('.site-search-result');
      if (!(link instanceof HTMLAnchorElement) || link.target === '_blank') return;

      const meta = link.querySelector('.site-search-result-meta')?.textContent || '';
      if (!meta.includes('日报')) return;

      const input = document.querySelector('.site-search-input');
      const searchTerm = input instanceof HTMLInputElement ? input.value.trim() : '';
      if (!searchTerm) return;

      const destination = new URL(link.href, window.location.href);
      if (!/\/daily\/[^/]+\/?$/.test(destination.pathname)) return;

      event.preventDefault();
      destination.searchParams.set('search', searchTerm);
      window.location.href = destination.href;
    }, true);

    const params = new URLSearchParams(window.location.search);
    const query = (params.get('search') || '').trim();
    if (!query) return;

    const article = document.querySelector('.report-layout article.prose');
    if (!(article instanceof HTMLElement)) return;

    const lower = (value: unknown): string => String(value ?? '')
      .normalize('NFKC')
      .toLocaleLowerCase('ja-JP');
    const compact = (value: unknown): string => lower(value).replace(/[\s\p{P}\p{S}]+/gu, '');
    const needle = lower(query);
    const compactNeedle = compact(query);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const ignoredParent = (node: Text): boolean => {
      const parent = node.parentElement;
      return Boolean(parent?.closest('script, style, noscript, svg, button, input, textarea, select'));
    };

    const scrollToTarget = (target: HTMLElement): void => {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
        });
      });
    };

    const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT, {
      acceptNode(node: Node): number {
        if (!(node instanceof Text) || ignoredParent(node)) return NodeFilter.FILTER_REJECT;
        const value = node.nodeValue || '';
        return lower(value).includes(needle) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP;
      },
    });

    const textNode = walker.nextNode();
    if (textNode instanceof Text) {
      const raw = textNode.nodeValue || '';
      const index = lower(raw).indexOf(needle);
      if (index >= 0) {
        const matched = textNode.splitText(index);
        matched.splitText(query.length);
        const mark = document.createElement('mark');
        mark.className = 'search-deep-highlight';
        mark.textContent = matched.nodeValue || '';
        matched.replaceWith(mark);
        scrollToTarget(mark);
        return;
      }
    }

    if (!compactNeedle) return;
    const blocks = article.querySelectorAll<HTMLElement>('h1, h2, h3, h4, p, li, blockquote, pre, code, td, th');
    for (const block of blocks) {
      if (!compact(block.textContent || '').includes(compactNeedle)) continue;
      block.classList.add('search-deep-block');
      scrollToTarget(block);
      return;
    }
  })();
</script>

<style is:global>
  .search-deep-highlight{
    border-radius:4px;
    background:color-mix(in srgb,var(--accent) 24%,var(--surface));
    color:inherit;
    outline:2px solid color-mix(in srgb,var(--accent) 64%,transparent);
    outline-offset:2px;
    scroll-margin-top:118px;
  }

  .search-deep-block{
    border-radius:8px;
    outline:2px solid color-mix(in srgb,var(--accent) 58%,transparent);
    outline-offset:5px;
    background:color-mix(in srgb,var(--accent-soft) 42%,transparent);
    scroll-margin-top:118px;
  }
</style>
