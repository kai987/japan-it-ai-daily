<script>
  (() => {
    const params = new URLSearchParams(window.location.search);
    const query = (params.get('search') || '').trim();
    if (!query) return;

    const article = document.querySelector('.report-layout article.prose');
    if (!(article instanceof HTMLElement)) return;

    const lower = (value) => String(value ?? '')
      .normalize('NFKC')
      .toLocaleLowerCase('ja-JP');
    const compact = (value) => lower(value).replace(/[\s\p{P}\p{S}]+/gu, '');
    const needle = lower(query);
    const compactNeedle = compact(query);

    const ignoredParent = (node) => {
      const parent = node.parentElement;
      return Boolean(parent?.closest('script, style, noscript, svg, button, input, textarea, select'));
    };

    const scrollToTarget = (target) => {
      if (!(target instanceof HTMLElement)) return;
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });
    };

    const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        if (!(node instanceof Text) || ignoredParent(node)) return NodeFilter.FILTER_REJECT;
        const value = node.nodeValue || '';
        return lower(value).includes(needle) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP;
      },
    });

    const textNode = walker.nextNode();
    if (textNode instanceof Text) {
      const raw = textNode.nodeValue || '';
      const index = lower(raw).indexOf(needle);
      if (index >= 0) {
        const matched = textNode.splitText(index);
        matched.splitText(query.length);
        const mark = document.createElement('mark');
        mark.className = 'search-deep-highlight';
        mark.textContent = matched.nodeValue || '';
        matched.replaceWith(mark);
        scrollToTarget(mark);
        return;
      }
    }

    if (!compactNeedle) return;
    const blocks = article.querySelectorAll('h1, h2, h3, h4, p, li, blockquote, pre, code, td, th');
    for (const block of blocks) {
      if (!(block instanceof HTMLElement)) continue;
      if (!compact(block.textContent || '').includes(compactNeedle)) continue;
      block.classList.add('search-deep-block');
      scrollToTarget(block);
      return;
    }
  })();
</script>

<style is:global>
  .search-deep-highlight{
    border-radius:4px;
    background:color-mix(in srgb,var(--accent) 24%,var(--surface));
    color:inherit;
    outline:2px solid color-mix(in srgb,var(--accent) 64%,transparent);
    outline-offset:2px;
    scroll-margin-top:118px;
  }

  .search-deep-block{
    border-radius:8px;
    outline:2px solid color-mix(in srgb,var(--accent) 58%,transparent);
    outline-offset:5px;
    background:color-mix(in srgb,var(--accent-soft) 42%,transparent);
    scroll-margin-top:118px;
  }

  @media(prefers-reduced-motion:reduce){
    .search-deep-highlight,.search-deep-block{scroll-behavior:auto}
  }
</style>
