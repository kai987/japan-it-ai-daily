<script is:inline>
  (() => {
    const pad = (value) => String(value).padStart(2, '0');
    const normalize = (value) => String(value || '').replace(/\s+/g, '').trim();

    const sectionNodes = (heading) => {
      const nodes = [];
      const depth = Number(heading.tagName.slice(1)) || 6;
      let node = heading.nextElementSibling;
      while (node) {
        const tag = node.tagName || '';
        const headingMatch = tag.match(/^H([1-6])$/);
        if (headingMatch && Number(headingMatch[1]) <= depth) break;
        nodes.push(node);
        node = node.nextElementSibling;
      }
      return nodes;
    };

    const blockquotesFrom = (nodes) => {
      const quotes = [];
      nodes.forEach((node) => {
        if (node instanceof HTMLQuoteElement) quotes.push(node);
        node.querySelectorAll?.('blockquote').forEach((quote) => {
          if (quote instanceof HTMLQuoteElement) quotes.push(quote);
        });
      });
      return Array.from(new Set(quotes));
    };

    const listItemsFrom = (nodes) => {
      const items = [];
      nodes.forEach((node) => {
        if (node instanceof HTMLLIElement) items.push(node);
        node.querySelectorAll?.('li').forEach((item) => {
          if (item instanceof HTMLLIElement) items.push(item);
        });
      });
      return Array.from(new Set(items));
    };

    const isLabelledAnswer = (quote) => {
      let previous = quote.previousElementSibling;
      for (let hops = 0; previous && hops < 2; hops += 1) {
        const label = normalize(previous.textContent);
        if (/(?:約|约)30秒.*(?:回答|答え)/i.test(label)) return true;
        if (/^(?:H[1-6])$/.test(previous.tagName)) break;
        previous = previous.previousElementSibling;
      }
      return false;
    };

    const revealHashTarget = () => {
      const id = decodeURIComponent(window.location.hash.replace(/^#/, ''));
      if (!/^(?:interview-answer|review-question)-\d+$/.test(id)) return;
      const target = document.getElementById(id);
      if (!(target instanceof HTMLElement)) return;

      requestAnimationFrame(() => {
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        target.classList.add('is-deep-link-target');
        window.setTimeout(() => target.classList.remove('is-deep-link-target'), 2400);
      });
    };

    const setupDailyAnchors = () => {
      const article = document.querySelector('.report-layout article.prose');
      if (!(article instanceof HTMLElement)) return;

      const headings = Array.from(article.querySelectorAll('h2, h3'));

      const interviewHeading = headings.find((heading) =>
        (heading.textContent || '').includes('面接で使えるポイント')
      );

      if (interviewHeading instanceof HTMLHeadingElement) {
        const quotes = blockquotesFrom(sectionNodes(interviewHeading));
        const labelledAnswers = quotes.filter(isLabelledAnswer);
        const answers = labelledAnswers.length ? labelledAnswers : quotes;

        answers.forEach((quote, index) => {
          quote.id = `interview-answer-${pad(index + 1)}`;
          quote.classList.add('interview-deep-target');
        });
      }

      const reviewHeading = headings.find((heading) =>
        (heading.textContent || '').includes('面试复习卡')
      );

      if (reviewHeading instanceof HTMLHeadingElement) {
        const reviewNodes = sectionNodes(reviewHeading);
        const questionQuotes = blockquotesFrom(reviewNodes);
        const targets = questionQuotes.length ? questionQuotes : listItemsFrom(reviewNodes);

        targets.forEach((target, index) => {
          target.id = `review-question-${pad(index + 1)}`;
          target.classList.add('review-deep-target');
        });
      }

      revealHashTarget();
      window.addEventListener('hashchange', revealHashTarget);
    };

    const attachNavigation = (element, href, ariaLabel) => {
      element.setAttribute('role', 'link');
      element.setAttribute('tabindex', '0');
      element.setAttribute('aria-label', ariaLabel);
      element.title = '点击查看日报中的原位置';

      const navigate = () => {
        if (window.getSelection()?.toString()) return;
        window.location.href = href;
      };

      element.addEventListener('click', (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest('a, button')) return;
        navigate();
      });

      element.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        navigate();
      });
    };

    const setupInterviewCards = () => {
      const days = Array.from(document.querySelectorAll('.interview-day'));
      if (!days.length) return;

      days.forEach((day) => {
        if (!(day instanceof HTMLElement)) return;
        const dailyLink = day.querySelector('.daily-link');
        if (!(dailyLink instanceof HTMLAnchorElement)) return;
        const dailyBase = dailyLink.href.split('#')[0];

        const cards = Array.from(day.querySelectorAll('.interview-answer-card'));
        cards.forEach((card, index) => {
          if (!(card instanceof HTMLElement)) return;
          const href = `${dailyBase}#interview-answer-${pad(index + 1)}`;
          card.classList.add('interview-answer-deep-link');
          attachNavigation(card, href, `当天日报の面接回答 ${index + 1} へ移動`);
        });

        const reviewQuestions = Array.from(day.querySelectorAll('.review-q'));
        reviewQuestions.forEach((question, index) => {
          if (!(question instanceof HTMLElement)) return;
          const href = `${dailyBase}#review-question-${pad(index + 1)}`;
          question.classList.add('review-question-deep-link');
          attachNavigation(question, href, `当天日报の復習問題 ${index + 1} へ移動`);
        });
      });
    };

    setupDailyAnchors();
    setupInterviewCards();
  })();
</script>

<style is:global>
  .interview-answer-card.interview-answer-deep-link,
  .review-q.review-question-deep-link{
    cursor:pointer;
    transition:border-color .16s ease,background-color .16s ease,transform .16s ease,box-shadow .16s ease,color .16s ease;
  }

  .interview-answer-card.interview-answer-deep-link:hover{
    border-color:color-mix(in srgb,var(--accent) 48%,var(--border));
    background:color-mix(in srgb,var(--accent-soft) 34%,var(--surface));
    transform:translateY(-2px);
  }

  .review-q.review-question-deep-link{
    border-radius:10px;
    margin:-6px;
    padding:6px;
  }

  .review-q.review-question-deep-link:hover{
    color:var(--accent-text);
    background:color-mix(in srgb,var(--accent-soft) 56%,transparent);
  }

  .interview-answer-card.interview-answer-deep-link:focus-visible,
  .review-q.review-question-deep-link:focus-visible{
    outline:3px solid color-mix(in srgb,var(--accent) 26%,transparent);
    outline-offset:3px;
  }

  .interview-answer-card.interview-answer-deep-link:focus-visible{
    border-color:var(--accent);
  }

  .prose blockquote.interview-deep-target,
  .prose blockquote.review-deep-target,
  .prose li.review-deep-target{
    scroll-margin-top:104px;
    transition:outline-color .2s ease,box-shadow .2s ease,background-color .2s ease;
  }

  .prose blockquote.interview-deep-target.is-deep-link-target,
  .prose blockquote.review-deep-target.is-deep-link-target,
  .prose li.review-deep-target.is-deep-link-target{
    outline:2px solid color-mix(in srgb,var(--accent) 78%,transparent);
    outline-offset:4px;
    box-shadow:0 0 0 8px color-mix(in srgb,var(--accent) 12%,transparent);
    background:color-mix(in srgb,var(--accent-soft) 44%,var(--surface));
  }

  @media(prefers-reduced-motion:reduce){
    .interview-answer-card.interview-answer-deep-link,
    .review-q.review-question-deep-link,
    .prose blockquote.interview-deep-target,
    .prose blockquote.review-deep-target,
    .prose li.review-deep-target{transition:none}
  }
</style>
