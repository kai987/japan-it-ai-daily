---
import '../styles/search.css';
import '../styles/search-snippet.css';
import type { SiteLocale } from '../lib/locale';

const { locale = 'zh' } = Astro.props as { locale?: SiteLocale };
const base = import.meta.env.BASE_URL;
const searchIndexUrl = locale === 'ja' ? `${base}ja/search-index.json` : `${base}search-index.json`;
---

<div class="site-search" data-site-search data-search-index-url={searchIndexUrl} data-search-locale={locale}>
  <div class="site-search-field">
    <svg class="site-search-icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="6.5"></circle>
      <path d="m16 16 4 4"></path>
    </svg>
    <input
      class="site-search-input"
      type="search"
      inputmode="search"
      placeholder="日報・記事を検索…"
      aria-label="日報・記事を検索"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="site-search-results"
      autocomplete="off"
      spellcheck="false"
    />
    <kbd class="site-search-shortcut" aria-hidden="true">⌘K</kbd>
  </div>
  <div class="site-search-popover" hidden>
    <div class="site-search-status">最近の記事</div>
    <div class="site-search-results" id="site-search-results" role="listbox" aria-label="検索結果"></div>
  </div>
</div>

<script>
  import { searchItemsAsync, type SearchResult } from '../lib/search';
  import { createSearchLoader } from '../lib/search-loader';

  (() => {
    const root = document.querySelector('[data-site-search]');
    const input = root?.querySelector('.site-search-input');
    const popover = root?.querySelector('.site-search-popover');
    const status = root?.querySelector('.site-search-status');
    const resultsEl = root?.querySelector('.site-search-results');
    if (
      !(root instanceof HTMLElement)
      || !(input instanceof HTMLInputElement)
      || !(popover instanceof HTMLElement)
      || !(status instanceof HTMLElement)
      || !(resultsEl instanceof HTMLElement)
    ) return;

    const indexUrl = root.dataset.searchIndexUrl || '';
    const locale = root.dataset.searchLocale === 'ja' ? 'ja' : 'zh';
    const reportLabel = locale === 'ja' ? '日報' : '日报';
    if (!indexUrl) return;

    root.addEventListener('pointerdown', (event) => event.stopPropagation());
    root.addEventListener('click', (event) => event.stopPropagation());

    const loader = createSearchLoader(indexUrl);
    let request: AbortController | null = null;
    let renderPromise: Promise<void> | null = null;
    let ready = false;
    let currentResults: SearchResult[] = [];
    let activeIndex = -1;
    let renderVersion = 0;
    let renderedQuery = '';
    let inputTimer: ReturnType<typeof setTimeout> | undefined;

    const appendHighlighted = (container: HTMLElement, text: string, query: string): void => {
      const lowerText = text.toLocaleLowerCase('ja-JP');
      const lowerQuery = query.toLocaleLowerCase('ja-JP');
      const hit = lowerQuery ? lowerText.indexOf(lowerQuery) : -1;
      if (hit < 0) {
        container.textContent = text;
        return;
      }

      container.append(document.createTextNode(text.slice(0, hit)));
      const mark = document.createElement('mark');
      mark.className = 'site-search-result-hit';
      mark.textContent = text.slice(hit, hit + lowerQuery.length);
      container.append(mark, document.createTextNode(text.slice(hit + lowerQuery.length)));
    };

    const close = (): void => {
      renderVersion += 1;
      request?.abort();
      clearTimeout(inputTimer);
      popover.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      activeIndex = -1;
    };

    const open = (): void => {
      popover.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };

    const syncActive = (): void => {
      const links = Array.from(resultsEl.querySelectorAll<HTMLAnchorElement>('.site-search-result'));
      links.forEach((link, index) => {
        const active = index === activeIndex;
        link.classList.toggle('is-active', active);
        link.setAttribute('aria-selected', String(active));
      });

      const active = links[activeIndex];
      if (active) {
        input.setAttribute('aria-activedescendant', active.id);
        active.scrollIntoView({ block: 'nearest' });
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    };

    const showLoadError = (): void => {
      currentResults = [];
      activeIndex = -1;
      resultsEl.replaceChildren();
      const empty = document.createElement('div');
      empty.className = 'site-search-empty';
      empty.textContent = '検索データを読み込めませんでした。もう一度お試しください。';
      resultsEl.appendChild(empty);
      status.textContent = '検索データの読み込みに失敗しました';
      open();
    };

    const renderNow = async (): Promise<void> => {
      const version = ++renderVersion;
      request?.abort();
      const controller = new AbortController();
      request = controller;
      const query = input.value.trim();
      ready = false;
      currentResults = [];
      input.removeAttribute('aria-activedescendant');
      status.textContent = query ? 'すべての日報を検索中…' : '最近の記事を読み込み中…';
      resultsEl.replaceChildren();
      open();
      try {
        const items = await (query ? loader.all(controller.signal) : loader.recent(controller.signal));
        const results = await searchItemsAsync(items, query, { signal: controller.signal });
        if (version !== renderVersion) return;
        currentResults = results;
      } catch (error) {
        if (controller.signal.aborted || version !== renderVersion) return;
        console.error('Search index load failed:', error);
        showLoadError();
        return;
      }
      ready = true;
      renderedQuery = query;
      activeIndex = -1;
      resultsEl.replaceChildren();
      status.textContent = query ? `${currentResults.length}件の候補` : '最近の記事';

      if (!currentResults.length) {
        const empty = document.createElement('div');
        empty.className = 'site-search-empty';
        empty.textContent = '一致する日報・記事が見つかりません';
        resultsEl.appendChild(empty);
        open();
        return;
      }

      currentResults.forEach((item, index) => {
        const link = document.createElement('a');
        link.className = 'site-search-result';
        link.id = `site-search-option-${index}`;
        link.setAttribute('role', 'option');
        link.setAttribute('aria-selected', 'false');

        if (item.kind === 'report' && query) {
          const targetUrl = new URL(item.href, window.location.origin);
          targetUrl.searchParams.set('search', query);
          link.href = `${targetUrl.pathname}${targetUrl.search}`;
        } else {
          link.href = item.href;
        }

        if (item.external) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }

        const title = document.createElement('span');
        title.className = 'site-search-result-title';
        title.textContent = item.title;
        link.appendChild(title);

        if (item.kind === 'report' && item.matchSnippet) {
          const snippet = document.createElement('span');
          snippet.className = 'site-search-result-snippet';
          appendHighlighted(snippet, item.matchSnippet, query);
          link.appendChild(snippet);
        }

        const meta = document.createElement('span');
        meta.className = 'site-search-result-meta';
        const pieces = item.kind === 'report'
          ? [item.date, reportLabel]
          : [item.date, item.source, item.topic].filter(Boolean);
        meta.textContent = `${pieces.join(' · ')}${item.external ? ' · 原文 ↗' : ''}`;
        link.appendChild(meta);

        link.addEventListener('pointerenter', () => {
          activeIndex = index;
          syncActive();
        });
        link.addEventListener('click', close);
        resultsEl.appendChild(link);
      });
      open();
    };

    const render = (): Promise<void> => {
      const promise = renderNow();
      renderPromise = promise;
      void promise.finally(() => { if (renderPromise === promise) renderPromise = null; });
      return promise;
    };

    input.addEventListener('input', (event) => {
      renderVersion += 1;
      request?.abort();
      clearTimeout(inputTimer);
      if (event instanceof InputEvent && event.isComposing) return;
      inputTimer = setTimeout(() => { void render(); }, 120);
    });
    input.addEventListener('compositionend', () => {
      clearTimeout(inputTimer);
      inputTimer = setTimeout(() => { void render(); }, 120);
    });
    input.addEventListener('focus', () => { void render(); });
    input.addEventListener('keydown', async (event) => {
      if (event.isComposing) return;
      if (['ArrowDown', 'ArrowUp', 'Enter'].includes(event.key)) {
        event.preventDefault();
        clearTimeout(inputTimer);
        if (!ready || popover.hidden || renderedQuery !== input.value.trim()) {
          await (renderPromise && !request?.signal.aborted ? renderPromise : render());
          if (document.activeElement !== input || popover.hidden || !ready
            || renderedQuery !== input.value.trim()) return;
        }
      }
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        activeIndex = currentResults.length ? (activeIndex + 1) % currentResults.length : -1;
        syncActive();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        activeIndex = currentResults.length
          ? (activeIndex <= 0 ? currentResults.length - 1 : activeIndex - 1)
          : -1;
        syncActive();
      } else if (event.key === 'Enter') {
        if (!currentResults.length) return;
        event.preventDefault();
        const links = resultsEl.querySelectorAll<HTMLAnchorElement>('.site-search-result');
        const target = links[activeIndex >= 0 ? activeIndex : 0];
        target?.click();
      } else if (event.key === 'Escape') {
        close();
        input.blur();
      }
    });

    document.addEventListener('pointerdown', (event) => {
      const target = event.target;
      if (target instanceof Node && !root.contains(target)) close();
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        input.focus();
        input.select();
      }
    });
  })();
</script>
