---
import '../styles/mermaid.css';
import InterviewDeepLinks from './InterviewDeepLinks.astro';
---

<script>
  type CodeBlock = { pre: HTMLPreElement; code: HTMLElement };
  type Layer = { title: string; detail: string };
  type FlowDiagram = {
    kind: 'flow';
    nodes: string[];
    direction: 'vertical' | 'horizontal';
  };
  type LayerDiagram = { kind: 'layers'; layers: Layer[] };
  type ParsedDiagram = FlowDiagram | LayerDiagram;

  const textLines = (source: unknown): string[] => String(source ?? '')
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);

  const legacyTextFlow = (source: unknown): FlowDiagram | null => {
    const lines = textLines(source);
    if (lines.length < 3 || !lines.includes('↓')) return null;
    if (lines.some((line) => line !== '↓' && line.length > 80)) return null;

    const nodes = lines.filter((line) => line !== '↓');
    if (nodes.length < 2 || nodes.length > 12) return null;

    const arrows = lines.filter((line) => line === '↓').length;
    if (arrows !== nodes.length - 1) return null;

    return { kind: 'flow', nodes, direction: 'vertical' };
  };

  const legacyLayerStack = (source: unknown): LayerDiagram | null => {
    const lines = textLines(source);
    if (lines.length < 4 || lines.length % 2 !== 0) return null;
    if (lines.length > 16 || lines.some((line) => line.length > 100)) return null;

    const layers: Layer[] = [];
    for (let index = 0; index < lines.length; index += 2) {
      const title = lines[index];
      const detail = lines[index + 1];
      if (!title || !detail) return null;

      const numbered = /^(?:[①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳]|\d+[.)]?)/.test(title);
      if (!numbered || !/layer|レイヤー/i.test(title) || detail === '↓') return null;
      layers.push({ title, detail });
    }

    if (layers.length < 2 || layers.length > 8) return null;
    return { kind: 'layers', layers };
  };

  const cleanMermaidLabel = (value: string): string => value
    .trim()
    .replace(/^['"]|['"]$/g, '')
    .replace(/<br\s*\/?>/gi, ' · ')
    .trim();

  const simpleMermaidFlow = (source: unknown): FlowDiagram | null => {
    const lines = textLines(source).filter((line) => !line.startsWith('%%'));
    const declaration = lines.shift()?.match(/^(?:flowchart|graph)\s+(TD|TB|LR|RL)$/i);
    if (!declaration) return null;

    const definitions = new Map<string, string>();
    const paths: string[][] = [];

    for (const line of lines) {
      const definition = line.match(/^([A-Za-z][\w-]*)\s*(?:\[\s*(.*?)\s*\]|\(\s*(.*?)\s*\)|\{\s*(.*?)\s*\})$/);
      if (definition) {
        const label = definition.slice(2).find((value) => typeof value === 'string' && value.length > 0) ?? definition[1];
        definitions.set(definition[1], cleanMermaidLabel(label));
        continue;
      }

      if (line.includes('-->')) {
        const ids = line.split(/\s*-->\s*/).map((part) => part.trim()).filter(Boolean);
        if (ids.length >= 2 && ids.every((id) => /^[A-Za-z][\w-]*$/.test(id))) paths.push(ids);
      }
    }

    if (paths.length !== 1) return null;
    const ids = paths[0];
    const nodes = ids.map((id) => definitions.get(id) ?? id);
    if (nodes.length < 2 || nodes.length > 12) return null;

    const direction = /^(LR|RL)$/i.test(declaration[1]) ? 'horizontal' : 'vertical';
    return { kind: 'flow', nodes, direction };
  };

  const parseLegacyText = (source: unknown): ParsedDiagram | null =>
    legacyTextFlow(source) ?? legacyLayerStack(source);

  const findCodeBlocks = (language: string): CodeBlock[] => {
    const blocks: CodeBlock[] = [];
    const seen = new Set<HTMLPreElement>();

    document.querySelectorAll<HTMLPreElement>(`pre[data-language="${language}"]`).forEach((pre) => {
      if (seen.has(pre)) return;
      const code = pre.querySelector<HTMLElement>(':scope > code');
      if (!code) return;
      seen.add(pre);
      blocks.push({ pre, code });
    });

    document.querySelectorAll<HTMLElement>(`pre > code.language-${language}`).forEach((code) => {
      const pre = code.parentElement;
      if (!(pre instanceof HTMLPreElement) || seen.has(pre)) return;
      seen.add(pre);
      blocks.push({ pre, code });
    });

    return blocks;
  };

  const makeArrow = (direction: FlowDiagram['direction']): HTMLElement => {
    const arrow = document.createElement('div');
    arrow.className = 'simple-flow-arrow';
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = direction === 'horizontal' ? '→' : '↓';
    return arrow;
  };

  const renderFlow = (diagram: FlowDiagram): HTMLElement => {
    const root = document.createElement('div');
    root.className = `simple-flow-diagram${diagram.direction === 'horizontal' ? ' is-horizontal' : ''}`;
    root.setAttribute('role', 'group');
    root.setAttribute('aria-label', `流程图：${diagram.nodes.join(' → ')}`);

    const stack = document.createElement('div');
    stack.className = 'simple-flow-stack';

    diagram.nodes.forEach((label, index) => {
      const node = document.createElement('div');
      node.className = 'simple-flow-node';
      node.textContent = label;
      stack.appendChild(node);
      if (index < diagram.nodes.length - 1) stack.appendChild(makeArrow(diagram.direction));
    });

    root.appendChild(stack);
    return root;
  };

  const renderLayers = (diagram: LayerDiagram): HTMLElement => {
    const root = document.createElement('div');
    root.className = 'simple-flow-diagram simple-layer-diagram';
    root.setAttribute('role', 'group');
    root.setAttribute('aria-label', `层级图：${diagram.layers.map((layer) => layer.title).join(' → ')}`);

    const stack = document.createElement('div');
    stack.className = 'simple-flow-stack simple-layer-stack';

    diagram.layers.forEach((layer, index) => {
      const node = document.createElement('div');
      node.className = 'simple-flow-node simple-layer-node';

      const title = document.createElement('strong');
      title.className = 'simple-layer-title';
      title.textContent = layer.title;

      const detail = document.createElement('span');
      detail.className = 'simple-layer-detail';
      detail.textContent = layer.detail;

      node.append(title, detail);
      stack.appendChild(node);
      if (index < diagram.layers.length - 1) stack.appendChild(makeArrow('vertical'));
    });

    root.appendChild(stack);
    return root;
  };

  const replaceBlock = (pre: HTMLPreElement, diagram: ParsedDiagram): void => {
    const rendered = diagram.kind === 'flow' ? renderFlow(diagram) : renderLayers(diagram);
    pre.replaceWith(rendered);
  };

  const initializeFlowRenderer = (): void => {
    findCodeBlocks('text').forEach(({ pre, code }) => {
      const diagram = parseLegacyText(code.textContent || '');
      if (diagram) replaceBlock(pre, diagram);
    });

    findCodeBlocks('mermaid').forEach(({ pre, code }) => {
      const diagram = simpleMermaidFlow(code.textContent || '');
      if (diagram) replaceBlock(pre, diagram);
    });
  };

  initializeFlowRenderer();
</script>

<InterviewDeepLinks />
