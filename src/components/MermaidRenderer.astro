---
import '../styles/mermaid.css';
import InterviewDeepLinks from './InterviewDeepLinks.astro';
---

<script>
  type MermaidApi = typeof import('mermaid')['default'];
  type CodeBlock = { pre: HTMLPreElement; code: HTMLElement };
  type Layer = { title: string; detail: string };

  let mermaidPromise: Promise<MermaidApi> | null = null;

  const loadMermaid = (): Promise<MermaidApi> => {
    if (!mermaidPromise) {
      mermaidPromise = import('mermaid').then((module) => module.default);
    }
    return mermaidPromise;
  };

  const escapeLabel = (value: unknown): string => String(value ?? '')
    .replace(/\\/g, '\\\\')
    .replace(/"/g, '\\"');

  const textLines = (source: unknown): string[] => String(source ?? '')
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);

  const legacyTextFlowToMermaid = (source: unknown): string => {
    const lines = textLines(source);

    if (lines.length < 3 || !lines.includes('↓')) return '';
    if (lines.some((line) => line !== '↓' && line.length > 80)) return '';

    const nodes = lines.filter((line) => line !== '↓');
    if (nodes.length < 2 || nodes.length > 12) return '';

    const arrows = lines.filter((line) => line === '↓').length;
    if (arrows !== nodes.length - 1) return '';

    const definitions = nodes.map((label, index) => `N${index}["${escapeLabel(label)}"]`);
    const path = nodes.map((_, index) => `N${index}`).join(' --> ');
    return `flowchart TD\n  ${definitions.join('\n  ')}\n  ${path}`;
  };

  const legacyLayerStackToMermaid = (source: unknown): string => {
    const lines = textLines(source);
    if (lines.length < 4 || lines.length % 2 !== 0) return '';
    if (lines.length > 16 || lines.some((line) => line.length > 100)) return '';

    const layers: Layer[] = [];
    for (let index = 0; index < lines.length; index += 2) {
      const title = lines[index];
      const detail = lines[index + 1];
      if (!title || !detail) return '';

      const numbered = /^(?:[①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳]|\d+[.)]?)/.test(title);
      if (!numbered || !/layer|レイヤー/i.test(title) || detail === '↓') return '';
      layers.push({ title, detail });
    }

    if (layers.length < 2 || layers.length > 8) return '';

    const definitions = layers.map(({ title, detail }, index) =>
      `L${index}["${escapeLabel(title)}<br/>${escapeLabel(detail)}"]`
    );
    const path = layers.map((_, index) => `L${index}`).join(' --> ');
    return `flowchart TD\n  ${definitions.join('\n  ')}\n  ${path}`;
  };

  const legacyTextToMermaid = (source: unknown): string =>
    legacyTextFlowToMermaid(source) || legacyLayerStackToMermaid(source);

  const makeDiagram = (source: string, replacementTarget: Element): HTMLElement => {
    const root = document.createElement('div');
    root.className = 'mermaid-diagram';
    root.dataset.mermaidSource = source;
    root.textContent = source;
    replacementTarget.replaceWith(root);
    return root;
  };

  const findCodeBlocks = (language: string): CodeBlock[] => {
    const blocks: CodeBlock[] = [];
    const seen = new Set<HTMLPreElement>();

    document.querySelectorAll<HTMLPreElement>(`pre[data-language="${language}"]`).forEach((pre) => {
      if (seen.has(pre)) return;
      const code = pre.querySelector<HTMLElement>(':scope > code');
      if (!code) return;
      seen.add(pre);
      blocks.push({ pre, code });
    });

    document.querySelectorAll<HTMLElement>(`pre > code.language-${language}`).forEach((code) => {
      const pre = code.parentElement;
      if (!(pre instanceof HTMLPreElement) || seen.has(pre)) return;
      seen.add(pre);
      blocks.push({ pre, code });
    });

    return blocks;
  };

  const collectDiagrams = (): void => {
    findCodeBlocks('mermaid').forEach(({ pre, code }) => {
      makeDiagram(code.textContent || '', pre);
    });

    findCodeBlocks('text').forEach(({ pre, code }) => {
      const source = legacyTextToMermaid(code.textContent || '');
      if (!source) return;
      makeDiagram(source, pre);
    });
  };

  const themeConfig = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    return {
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      fontFamily: 'Inter, Noto Sans JP, Yu Gothic, YuGothic, system-ui, sans-serif',
      flowchart: {
        htmlLabels: true,
        useMaxWidth: true,
        curve: 'basis',
        nodeSpacing: 32,
        rankSpacing: 34,
      },
      themeVariables: dark
        ? {
            background: '#16191f',
            primaryColor: '#1f2937',
            primaryTextColor: '#f3f5f7',
            primaryBorderColor: '#526071',
            secondaryColor: '#242946',
            tertiaryColor: '#111827',
            lineColor: '#a9b3c3',
            textColor: '#f3f5f7',
            edgeLabelBackground: '#16191f',
            clusterBkg: '#16191f',
            clusterBorder: '#374151',
            mainBkg: '#1f2937',
            nodeBorder: '#526071',
          }
        : {
            background: '#f7f8fa',
            primaryColor: '#ffffff',
            primaryTextColor: '#15171a',
            primaryBorderColor: '#cfd5df',
            secondaryColor: '#eef0ff',
            tertiaryColor: '#f7f8fa',
            lineColor: '#667085',
            textColor: '#15171a',
            edgeLabelBackground: '#f7f8fa',
            clusterBkg: '#f7f8fa',
            clusterBorder: '#d8dde6',
            mainBkg: '#ffffff',
            nodeBorder: '#cfd5df',
          },
    };
  };

  let rendering = false;
  let rerenderRequested = false;

  const renderDiagrams = async (): Promise<void> => {
    const roots = Array.from(document.querySelectorAll('.mermaid-diagram'))
      .filter((node): node is HTMLElement => node instanceof HTMLElement);
    if (!roots.length) return;

    if (rendering) {
      rerenderRequested = true;
      return;
    }

    rendering = true;

    try {
      const mermaid = await loadMermaid();
      mermaid.initialize(themeConfig());

      roots.forEach((root) => {
        const source = root.dataset.mermaidSource || '';
        root.removeAttribute('data-processed');
        root.replaceChildren();
        root.textContent = source;
      });

      await mermaid.run({ nodes: roots });
    } catch (error) {
      console.error('Mermaid render failed:', error);
    } finally {
      rendering = false;
      if (rerenderRequested) {
        rerenderRequested = false;
        queueMicrotask(() => { void renderDiagrams(); });
      }
    }
  };

  const initializeMermaidRenderer = async (): Promise<void> => {
    collectDiagrams();
    if (!document.querySelector('.mermaid-diagram')) return;

    await renderDiagrams();

    const observer = new MutationObserver((mutations) => {
      if (mutations.some((mutation) => mutation.attributeName === 'data-theme')) {
        void renderDiagrams();
      }
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  };

  void initializeMermaidRenderer().catch((error: unknown) => {
    console.error('Mermaid initialization failed:', error);
  });
</script>

<InterviewDeepLinks />
