---
import '../styles/mermaid.css';
import InterviewDeepLinks from './InterviewDeepLinks.astro';
---

<script>
  import {
    parseLegacyText,
    parseSimpleMermaidFlow,
    type FlowDiagram,
    type LayerDiagram,
    type ParsedDiagram,
  } from '../lib/flowDiagram';

  type CodeBlock = { pre: HTMLPreElement; code: HTMLElement };

  const findCodeBlocks = (language: string): CodeBlock[] => {
    const blocks: CodeBlock[] = [];
    const seen = new Set<HTMLPreElement>();

    document.querySelectorAll<HTMLPreElement>(`pre[data-language="${language}"]`).forEach((pre) => {
      if (seen.has(pre)) return;
      const code = pre.querySelector<HTMLElement>(':scope > code');
      if (!code) return;
      seen.add(pre);
      blocks.push({ pre, code });
    });

    document.querySelectorAll<HTMLElement>(`pre > code.language-${language}`).forEach((code) => {
      const pre = code.parentElement;
      if (!(pre instanceof HTMLPreElement) || seen.has(pre)) return;
      seen.add(pre);
      blocks.push({ pre, code });
    });

    return blocks;
  };

  const makeArrow = (direction: FlowDiagram['direction']): HTMLElement => {
    const arrow = document.createElement('div');
    arrow.className = 'simple-flow-arrow';
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = direction === 'horizontal' ? '→' : '↓';
    return arrow;
  };

  const renderFlow = (diagram: FlowDiagram): HTMLElement => {
    const root = document.createElement('div');
    root.className = `simple-flow-diagram${diagram.direction === 'horizontal' ? ' is-horizontal' : ''}`;
    root.setAttribute('role', 'group');
    root.setAttribute('aria-label', `流程图：${diagram.nodes.join(' → ')}`);

    const stack = document.createElement('div');
    stack.className = 'simple-flow-stack';

    diagram.nodes.forEach((label, index) => {
      const node = document.createElement('div');
      node.className = 'simple-flow-node';
      node.textContent = label;
      stack.appendChild(node);
      if (index < diagram.nodes.length - 1) stack.appendChild(makeArrow(diagram.direction));
    });

    root.appendChild(stack);
    return root;
  };

  const renderLayers = (diagram: LayerDiagram): HTMLElement => {
    const root = document.createElement('div');
    root.className = 'simple-flow-diagram simple-layer-diagram';
    root.setAttribute('role', 'group');
    root.setAttribute('aria-label', `层级图：${diagram.layers.map((layer) => layer.title).join(' → ')}`);

    const stack = document.createElement('div');
    stack.className = 'simple-flow-stack simple-layer-stack';

    diagram.layers.forEach((layer, index) => {
      const node = document.createElement('div');
      node.className = 'simple-flow-node simple-layer-node';

      const title = document.createElement('strong');
      title.className = 'simple-layer-title';
      title.textContent = layer.title;

      const detail = document.createElement('span');
      detail.className = 'simple-layer-detail';
      detail.textContent = layer.detail;

      node.append(title, detail);
      stack.appendChild(node);
      if (index < diagram.layers.length - 1) stack.appendChild(makeArrow('vertical'));
    });

    root.appendChild(stack);
    return root;
  };

  const replaceBlock = (pre: HTMLPreElement, diagram: ParsedDiagram): void => {
    const rendered = diagram.kind === 'flow' ? renderFlow(diagram) : renderLayers(diagram);
    pre.replaceWith(rendered);
  };

  const initializeFlowRenderer = (): void => {
    findCodeBlocks('text').forEach(({ pre, code }) => {
      const diagram = parseLegacyText(code.textContent || '');
      if (diagram) replaceBlock(pre, diagram);
    });

    findCodeBlocks('mermaid').forEach(({ pre, code }) => {
      const diagram = parseSimpleMermaidFlow(code.textContent || '');
      if (diagram) replaceBlock(pre, diagram);
    });
  };

  initializeFlowRenderer();
</script>

<InterviewDeepLinks />
