---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getJapaneseArticleTitle } from '../../lib/articleTitles';


import type { CollectionEntry } from 'astro:content';
import type { SiteLocale } from '../../lib/locale';
import LegacyReportEnhancements from '../LegacyReportEnhancements.astro';
import { titleWithIssue, getStudyDay } from '../../../scripts/learning-review.mjs';
import ReportStudySupplement from '../ReportStudySupplement.astro';
import ReportSpeechEnhancer from '../ReportSpeechEnhancer.astro';
import StudyFocusTarget from '../StudyFocusTarget.astro';
const { report, locale } = Astro.props as { report: CollectionEntry<'daily'> | CollectionEntry<'dailyJa'>; locale: SiteLocale };
const numberedTitle = titleWithIssue(report.data.title, report.id);
const study = getStudyDay(report.id, locale);
const { Content, headings } = await render(report);
const normalizeLeadReportTitle = (value: string) => value
  .normalize('NFKC')
  .replace(/^[🇯🇵🇨🇳\s]+/gu, '')
  .replace(/\s*[（(]第\d+号[）)]\s*$/u, '')
  .replace(/\s+/g, ' ')
  .trim();
const firstBodyHeading = headings[0];
const duplicateLeadHeading = Boolean(
  firstBodyHeading
  && firstBodyHeading.depth === 1
  && normalizeLeadReportTitle(firstBodyHeading.text ?? '') === normalizeLeadReportTitle(report.data.title)
);
const duplicateLeadSlug = duplicateLeadHeading ? firstBodyHeading.slug : '';
const lessons = locale === 'zh' ? await getCollection('japanese') : [];
const hasNativeJapanese = headings.some((heading:any) => {
  if (heading.depth > 2) return false;
  return /^C[.．]\s*/.test((heading.text ?? '').trim());
});
const supplement = hasNativeJapanese ? undefined : lessons.find((lesson) => lesson.id === report.id);
const renderedSupplement = supplement ? await render(supplement) : undefined;
const SupplementContent = renderedSupplement?.Content;
const topTitles = (report.data.top ?? []).slice(0, 5).map((item:any) => getJapaneseArticleTitle(item));
let inTopFive = false;
let topHeadingIndex = 0;
const normalizedHeadings = locale === 'ja' ? headings : headings.map((heading:any) => {
  if (heading.depth === 2 && heading.text.includes('今日最值得看的 5 篇')) {
    inTopFive = true;
    topHeadingIndex = 0;
    return heading;
  }
  if (inTopFive && heading.depth === 3 && topHeadingIndex < topTitles.length) {
    const number = ['①', '②', '③', '④', '⑤'][topHeadingIndex] ?? '';
    const normalized = { ...heading, text: `${number} ${topTitles[topHeadingIndex]}` };
    topHeadingIndex += 1;
    if (topHeadingIndex >= topTitles.length) inTopFive = false;
    return normalized;
  }
  return heading;
});
const tocHeadings = [
  ...normalizedHeadings,
  ...(renderedSupplement?.headings ?? [])
].filter((heading:any) => heading.depth <= 3 && heading.slug !== duplicateLeadSlug);
---
<BaseLayout locale={locale} title={`${numberedTitle} · Japan IT / AI Daily`} description={report.data.description}>
  <div class="container report-layout" data-top-titles={locale === 'zh' ? JSON.stringify(topTitles) : undefined}>
    <article class={`prose${duplicateLeadHeading ? ' has-duplicate-lead-title' : ''}`}>
      <div class="eyebrow">{report.data.date.toLocaleDateString('ja-JP')}</div>
      <h1>{numberedTitle}</h1>
      <p class="meta">{report.data.description}</p>
      <p class="meta" data-study-counts>{locale === "ja" ? `学習：語彙 ${study.vocabulary.length} 新規＋${study.reviewVocabulary.length} 復習 ／ 文法 ${study.grammar.length} 新規＋${study.reviewGrammar.length} 復習` : `学习：词汇 ${study.vocabulary.length} 新学＋${study.reviewVocabulary.length} 复习 ／ 语法 ${study.grammar.length} 新学＋${study.reviewGrammar.length} 复习`}</p>
      <p class="meta" data-grammar-range>{locale === 'ja' ? '文法：新規＋復習で5～8項目が目安。適切な用例が少ない日は無理に8項目まで増やしません。' : '语法：新学＋复习合计5～8项为参考范围，合格用例不足时不强行补满8项。'}</p>
      <div class="tags">{report.data.topics.map((topic:string) => <span class="tag">{topic}</span>)}</div>
      <Content />
      <ReportStudySupplement study={study} locale={locale} />
      {SupplementContent && (
        <section class="learning-supplement">
          <div class="supplement-note">历史日报补生成 · JLPT 等级为学习参考</div>
          <SupplementContent />
        </section>
      )}
    </article>
    <aside class="toc" aria-label={locale === 'ja' ? 'このページの目次' : 'On this page'}>
      <h4>目次</h4>
      {tocHeadings.map((heading:any)=><a href={`#${heading.slug}`}>{heading.text}</a>)}
    </aside>
  </div>

  {locale === "zh" && <LegacyReportEnhancements />}
  <ReportSpeechEnhancer />
  <StudyFocusTarget />
  <style>
    .prose.has-duplicate-lead-title > .tags + h1{
      display:none;
    }
    .report-speech-target{
      display:flex;
      align-items:flex-start;
      gap:10px;
      min-width:0;
    }
    .report-speech-target > p{
      flex:1 1 auto;
      min-width:0;
      margin-top:0;
      margin-bottom:0;
    }
    .report-speech-button{
      position:static;
      flex:0 0 34px;
      margin-top:1px;
      z-index:1;
    }
    @media(max-width:800px){
      .report-speech-target{gap:9px}
      .report-speech-button{
        flex-basis:38px;
        margin-top:0;
      }
    }
  </style>
</BaseLayout>