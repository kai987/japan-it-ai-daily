---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';


import type { CollectionEntry } from 'astro:content';
import { localeRoot, type SiteLocale } from '../../lib/locale';
import { pageCopy } from '../../lib/pageCopy';
import { learningView } from '../../lib/learningView';
import LessonAudio from '../LessonAudio.astro';
import StudyBadge from '../StudyBadge.astro';
const { lesson, locale } = Astro.props as { lesson: CollectionEntry<'japanese'> | CollectionEntry<'japaneseJa'>; locale: SiteLocale };
const data = learningView(lesson);
const copy = pageCopy.Lesson[locale];
const { Content, headings } = await render(lesson);
const base = import.meta.env.BASE_URL;
const root = localeRoot(base, locale);
const hasStructuredCards = data.vocabulary.length > 0 || data.grammar.length > 0;
const legacyTocHeadings = headings.filter((heading:any) => heading.depth < 4);
const jlptOrder = ['N5/N4', 'N3', 'N2', 'N1'];
const vocabGroups = jlptOrder
  .map((level) => ({ level, items: data.vocabulary.map((item: any, index: number) => ({ item, index })).filter(({ item }: any) => item.level === level) }))
  .filter((group) => group.items.length > 0);
if (data.reviewVocabulary.length) vocabGroups.push({ level: '本文で復習できる既習語彙', items: data.reviewVocabulary.map((item: any, index: number) => ({item,index})) });
const grammarGroups = [
  { title: locale === 'ja' ? '新規文法' : '新学语法', kind: 'new', items: data.grammar },
  { title: '本文で復習できる既習文法', kind: 'review', items: data.reviewGrammar },
].filter(group => group.items.length);

---
<BaseLayout locale={locale} title={`${data.title} · Japan IT / AI Daily`} description={data.description}>
  <div class="container report-layout lesson-detail">
    <article class="prose lesson-prose">
      <div class="eyebrow">{data.date.toLocaleDateString('ja-JP')} · JLPT + IT日本語</div>
      <h1>{data.title}</h1>
      <p class="meta">{data.description}</p>
      <p class="meta" data-study-counts>{locale === 'ja' ? `語彙 ${data.vocabulary.length} 新規＋${data.reviewVocabulary.length} 復習＝${data.studyVocabularyCount}語 ／ 文法 ${data.grammar.length} 新規＋${data.reviewGrammar.length} 復習＝${data.studyGrammarCount}項目` : `词汇 ${data.vocabulary.length} 新学＋${data.reviewVocabulary.length} 复习＝${data.studyVocabularyCount}词 ／ 语法 ${data.grammar.length} 新学＋${data.reviewGrammar.length} 复习＝${data.studyGrammarCount}项`}</p>
      <p class="meta" data-grammar-range>{locale === 'ja' ? '文法は新規＋復習で5～8項目が目安です。8項目は上限で、当日の適切な用例が少ない場合は実際の件数を表示します。' : '语法以新学＋复习合计5～8项为参考范围，8项是上限，不是必须凑满的数量；候选不足时显示实际数量。'}</p>
      <div class="tags">{data.levels.map((level:string) => <span class="tag">{level}</span>)}</div>
      <p class="meta">{locale === 'ja' ? '音声は収録内容と一致する場合のみ再生します。未収録の語彙・例文はブラウザーの日本語音声で読み上げます。' : '只播放与当前词条相符的录音；尚无录音的新词和例句使用浏览器日语朗读。'}</p>
      <p class="learning-back"><a href={`${root}japanese/`}>{copy.back}</a></p>

      {hasStructuredCards ? (
        <Fragment>
          <section class="study-section" id="c-1-jlpt-vocabulary">
            <div class="study-section-heading">
              <div>
                <div class="entry-kicker">C-1 · Vocabulary</div>
                <h2>{copy.vocab}</h2>
              </div>
              <p>{copy.dictionary}</p>
            </div>

            {vocabGroups.map((group) => (
              <section class="study-level-group" id={`vocab-${group.level.toLowerCase().replace('/','-')}`}>
                <div class="study-level-title"><span>{group.level}</span><small>{group.items.length} {locale === 'ja' ? '語' : 'words'}</small></div>
                <div class="study-card-grid">
                  {group.items.map(({ item }: { item: any }) => (
                    <article class="study-card vocabulary-card" data-study-kind={item.studyKind}>
                      <header class="study-card-header">
                        <div>
                          <div class="study-term-line">
                            <h3>{item.term}<span class="reading">（{item.reading}）</span></h3>
                            <button
                              class="speech-button"
                              type="button"
                              data-speech={item.reading || item.term}
                              data-speech-kind="word"
                              data-vocabulary-term={item.term}
                              data-vocabulary-reading={item.reading}
                              aria-label={`${item.term}の発音を再生`}
                              aria-pressed="false"
                              title={copy.wordTitle}
                            >
                              <svg class="speech-icon-speaker" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M11 5 7 9H4v6h3l4 4V5Z"></path>
                                <path d="M15 9.5a4 4 0 0 1 0 5M17.5 7a7.3 7.3 0 0 1 0 10"></path>
                              </svg>
                              <svg class="speech-icon-stop" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="7" y="7" width="10" height="10" rx="1"></rect>
                              </svg>
                            </button>
                          </div>
                          <div class="study-pos">{item.partOfSpeech}</div>
                        </div>
                        <StudyBadge item={item} locale={locale} />
                      </header>
                      {item.studyKind === 'review' && <div class="nuance-note" data-review-evidence><strong>本文で復習</strong><p lang="ja">{item.reviewEvidence.excerpt}</p><a href={`${root}japanese/${item.firstIntroducedDate}/`}>{locale === 'ja' ? '初出' : '首次学习'}：{item.firstIntroducedDate}</a></div>}

                      <div class="study-field">
                        <span class="study-label">{copy.meaning}</span>
                        <p class="study-meaning">{item.meaning}</p>
                      </div>

                      {item.collocations.length > 0 && (
                        <div class="study-field">
                          <span class="study-label">{copy.collocations}</span>
                          <div class="phrase-list">
                            {item.collocations.map((phrase: string) => <span>{phrase}</span>)}
                          </div>
                        </div>
                      )}

                      <div class="study-field">
                        <span class="study-label">{copy.context}</span>
                        <p>{item.note}</p>
                      </div>

                      <div class="example-box">
                        <div class="example-label-row">
                          <span class="study-label">{copy.example}</span>
                          <button
                            class="speech-button"
                            type="button"
                            data-speech={item.exampleJa}
                            data-speech-kind="example"
                            data-vocabulary-term={item.term}
                            data-vocabulary-reading={item.reading}
                            aria-label="例文を読み上げる"
                            aria-pressed="false"
                            title={copy.exampleTitle}
                          >
                            <svg class="speech-icon-speaker" viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M11 5 7 9H4v6h3l4 4V5Z"></path>
                              <path d="M15 9.5a4 4 0 0 1 0 5M17.5 7a7.3 7.3 0 0 1 0 10"></path>
                            </svg>
                            <svg class="speech-icon-stop" viewBox="0 0 24 24" aria-hidden="true">
                              <rect x="7" y="7" width="10" height="10" rx="1"></rect>
                            </svg>
                          </button>
                        </div>
                        <p lang="ja">{item.exampleJa}</p>
                        {item.exampleMeaning && <small>{item.exampleMeaning}</small>}
                      </div>

                      {item.nuance && (
                        <div class="nuance-note">
                          <span class="study-label">{copy.nuance}</span>
                          <p>{item.nuance}</p>
                        </div>
                      )}
                    </article>
                  ))}
                </div>
              </section>
            ))}
            {data.reviewVocabularyNote && <p class="meta">{data.reviewVocabularyNote}</p>}
          </section>

          {data.technicalTerms.length > 0 && (
            <section class="study-section" id="c-2-it-ai-terms">
              <div class="study-section-heading">
                <div>
                  <div class="entry-kicker">C-2 · Technical Terms</div>
                  <h2>{copy.tech}</h2>
                </div>
                <p>{copy.techIntro}</p>
              </div>
              <div class="technical-term-grid">
                {data.technicalTerms.map((item: any) => (
                  <article class="technical-term-card">
                    <h3>{item.term}</h3>
                    {item.japanese && <div class="meta">{item.japanese}</div>}
                    <p><strong>{item.meaning}</strong></p>
                    <p>{item.context}</p>
                  </article>
                ))}
              </div>
            </section>
          )}

          <section class="study-section" id="c-3-jlpt-grammar">
            <div class="study-section-heading">
              <div>
                <div class="entry-kicker">C-3 · Grammar</div>
                <h2>{copy.grammar}</h2>
              </div>
              <p>{copy.grammarIntro}</p>
            </div>
            {data.grammarSelectionNote && <p class="meta" data-grammar-selection-note>{data.grammarSelectionNote}</p>}
            {grammarGroups.map(group => (
            <section class="study-level-group" data-grammar-group={group.kind}>
            <h3>{group.title}（{group.items.length}）</h3>
            <div class="grammar-card-grid">
              {group.items.map((item: any) => (
                <article class="study-card grammar-card" data-study-kind={item.studyKind}>
                  <header class="study-card-header">
                    <h3>{item.pattern}</h3>
                    <StudyBadge item={item} locale={locale} />
                  </header>
                  {item.studyKind === 'review' && <div class="nuance-note" data-review-evidence><strong>本文で復習</strong><p lang="ja">{item.reviewEvidence.excerpt}</p><a href={`${root}japanese/${item.firstIntroducedDate}/`}>{locale === 'ja' ? '初出' : '首次学习'}：{item.firstIntroducedDate}</a></div>}
                  <div class="study-field">
                    <span class="study-label">{copy.meaning}</span>
                    <p class="study-meaning">{item.meaning}</p>
                  </div>
                  <div class="grammar-structure"><span>{copy.structure}</span><code>{item.structure}</code></div>
                  <div class="study-field">
                    <span class="study-label">{copy.usage}</span>
                    <p>{item.usage}</p>
                  </div>
                  <div class="example-box">
                    <div class="example-label-row">
                      <span class="study-label">{copy.example}</span>
                      <button
                        class="speech-button"
                        type="button"
                        data-speech={item.exampleJa}
                        data-speech-kind="grammar-example"
                        
                        aria-label={copy.grammarAria}
                        aria-pressed="false"
                        title={locale === 'ja' ? copy.grammarAria : '语法例句朗读'}
                      >
                        <svg class="speech-icon-speaker" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M11 5 7 9H4v6h3l4 4V5Z"></path>
                          <path d="M15 9.5a4 4 0 0 1 0 5M17.5 7a7.3 7.3 0 0 1 0 10"></path>
                        </svg>
                        <svg class="speech-icon-stop" viewBox="0 0 24 24" aria-hidden="true">
                          <rect x="7" y="7" width="10" height="10" rx="1"></rect>
                        </svg>
                      </button>
                    </div>
                    <p lang="ja">{item.exampleJa}</p>
                    {item.exampleMeaning && <small>{item.exampleMeaning}</small>}
                  </div>
                  {item.note && (
                    <div class="nuance-note"><span class="study-label">注意</span><p>{item.note}</p></div>
                  )}
                </article>
              ))}
            </div>
            </section>
            ))}
            {data.reviewGrammarNote && <p class="meta">{data.reviewGrammarNote}</p>}
          </section>

          {(data.mustRememberWords.length > 0 || data.mustRememberGrammar.length > 0) && (
            <section class="study-section remember-section" id="c-4-must-remember">
              <div class="entry-kicker">C-4 · Review</div>
              <h2>{copy.remember}</h2>
              {data.mustRememberWords.length > 0 && (
                <div class="remember-row"><strong>{copy.words}</strong><div class="remember-chips">{data.mustRememberWords.map((item: string) => <span>{item}</span>)}</div></div>
              )}
              {data.mustRememberGrammar.length > 0 && (
                <div class="remember-row"><strong>{copy.patterns}</strong><div class="remember-chips">{data.mustRememberGrammar.map((item: string) => <span>{item}</span>)}</div></div>
              )}
            </section>
          )}
        </Fragment>
      ) : (
        <div class="legacy-lesson"><Content /></div>
      )}
    </article>

    <aside class="toc" aria-label={copy.tocAria}>
      <h4>目次</h4>
      {hasStructuredCards ? (
        <Fragment>
          <a href="#c-1-jlpt-vocabulary">{copy.tocVocab}</a>
          {data.technicalTerms.length > 0 && <a href="#c-2-it-ai-terms">{copy.tocTech}</a>}
          <a href="#c-3-jlpt-grammar">{copy.tocGrammar}</a>
          {(data.mustRememberWords.length > 0 || data.mustRememberGrammar.length > 0) && <a href="#c-4-must-remember">{copy.tocRemember}</a>}
        </Fragment>
      ) : (
        legacyTocHeadings.map((heading:any)=><a href={`#${heading.slug}`}>{heading.text}</a>)
      )}
    </aside>
  </div>

  <LessonAudio />
</BaseLayout>
