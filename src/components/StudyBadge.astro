---
import { FREQUENCY_SCOPE } from '../../scripts/learning-review.mjs';
const { item, locale = 'zh' } = Astro.props;
const frequency = item.reportFrequency;
const frequencyRows = frequency ? Array.from({ length: Math.ceil(frequency.appearedDates.length / 2) }, (_, index) => frequency.appearedDates.slice(index * 2, index * 2 + 2)) : [];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const focusLabel = item.term || item.pattern || item.identity || '';
const focusHref = (date: string) => {
  const form = frequency?.appearanceForms?.[date] || focusLabel;
  return `${base}ja/daily/${date}/?studyFocus=${encodeURIComponent(form)}`;
};
---
<div class="study-meta" data-study-kind={item.studyKind}>
  <div class="study-badge-stack">
    <span class="level-badge">参考：{item.level}</span>
    <span class="study-kind">{item.studyKind === 'review' ? '復習' : (locale === 'ja' ? '新規' : '新学')}</span>
  </div>
  {frequency && <details class="study-frequency" data-frequency-days={frequency.appearedDays} data-frequency-total={frequency.totalDays}>
    <summary title={locale === 'ja' ? '出現した日報の日数 ÷ 全日報の日数 × 100%。同日・日中版は重複集計しません。' : FREQUENCY_SCOPE}>
      <span class="frequency-primary">出現頻度：{frequency.percent.toFixed(1)}%</span>
      <span class="frequency-ratio">（{frequency.appearedDays}/{frequency.totalDays}日）</span>
    </summary>
    <div class="frequency-details">
      <p>{locale === 'ja' ? '日報本文・推薦理由・学習カードに出現した日を集計。外部記事の全文は含みません。' : FREQUENCY_SCOPE}</p>
      <div class="frequency-dates">
        {frequencyRows.map((row: string[]) => (
          <div class="frequency-date-row" data-date-count={row.length}>
            {row.map((date: string, index: number) => (
              <Fragment>
                {index > 0 && <span class="frequency-date-separator" aria-hidden="true"> / </span>}
                {item.studyKind === 'review'
                  ? <a class="frequency-date-link" href={focusHref(date)} target="_blank" rel="noopener noreferrer" data-frequency-date={date}>{date}</a>
                  : <span class="frequency-date" data-frequency-date={date}>{date}</span>}
              </Fragment>
            ))}
          </div>
        ))}
      </div>
    </div>
  </details>}
</div>
<style>
  .study-meta{
    display:flex;
    flex-direction:column;
    align-items:flex-end;
    gap:7px;
    max-width:260px;
    min-width:120px;
    flex:0 0 auto;
    margin-left:auto;
    text-align:right;
  }
  .study-badge-stack{
    display:flex;
    flex-direction:column;
    align-items:flex-end;
    gap:5px;
  }
  .level-badge{white-space:nowrap}
  .study-kind{
    display:block;
    font-size:12px;
    font-weight:700;
    color:var(--muted);
    line-height:1.4;
    text-align:right;
  }
  .study-frequency{
    display:block;
    width:100%;
    max-width:100%;
    color:var(--muted);
    font-size:12px;
    line-height:1.55;
    overflow-wrap:anywhere;
    text-align:right;
  }
  .study-frequency summary{
    cursor:pointer;
    display:grid;
    grid-template-columns:auto auto;
    grid-template-areas:
      "marker primary"
      ". ratio";
    justify-content:end;
    align-items:start;
    column-gap:4px;
    row-gap:1px;
    list-style:none;
    font-variant-numeric:tabular-nums;
    text-align:right;
  }
  .study-frequency summary::-webkit-details-marker{display:none}
  .study-frequency summary::before{
    content:'▶';
    grid-area:marker;
    font-size:.82em;
    line-height:1.9;
  }
  .study-frequency[open] summary::before{content:'▼'}
  .frequency-primary{grid-area:primary;white-space:nowrap}
  .frequency-ratio{grid-area:ratio;white-space:nowrap}
  .frequency-details{
    --frequency-expanded-width:min(19.5ch, calc(100vw - 56px));
    width:var(--frequency-expanded-width);
    max-width:var(--frequency-expanded-width);
    margin-left:calc(100% - var(--frequency-expanded-width));
    text-align:right;
  }
  .frequency-details>p{
    width:100%;
    max-width:100%;
  }
  .frequency-dates{
    display:grid;
    grid-template-columns:1fr;
    gap:2px;
    width:100%;
    margin:5px 0 0;
    font-variant-numeric:tabular-nums;
    text-align:right;
  }
  .frequency-date-row{
    width:100%;
    white-space:nowrap;
    text-align:right;
  }
  .frequency-date-link{color:inherit;text-decoration:underline;text-decoration-color:color-mix(in srgb,var(--muted) 45%,transparent);text-underline-offset:2px}
  .frequency-date-link:hover{color:var(--accent);text-decoration-color:currentColor}
  .frequency-date-link:focus-visible{outline:2px solid color-mix(in srgb,var(--accent) 55%,transparent);outline-offset:2px;border-radius:3px}
  .frequency-date-separator{white-space:pre}
  .study-frequency p{font-size:12px;margin:5px 0}
  @media(max-width:600px){
    .study-meta{width:100%;max-width:none;min-width:120px}
    .study-frequency{font-size:12px}
  }
</style>