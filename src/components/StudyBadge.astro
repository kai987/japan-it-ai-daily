---
import { frequencyText, FREQUENCY_SCOPE } from '../../scripts/learning-review.mjs';
const { item, locale = 'zh' } = Astro.props;
const frequency = item.reportFrequency;
---
<div class="study-meta" data-study-kind={item.studyKind}>
  <span class="level-badge">参考：{item.level}</span>
  <span class="study-kind">{item.studyKind === 'review' ? '復習' : (locale === 'ja' ? '新規' : '新学')}</span>
  {frequency && <details class="study-frequency" data-frequency-days={frequency.appearedDays} data-frequency-total={frequency.totalDays}>
    <summary title={locale === 'ja' ? '出現した日報の日数 ÷ 全日報の日数 × 100%。同日・日中版は重複集計しません。' : FREQUENCY_SCOPE}>{frequencyText(frequency, locale)}</summary>
    <p>{locale === 'ja' ? '日報本文・推薦理由・学習カードに出現した日を集計。外部記事の全文は含みません。' : FREQUENCY_SCOPE}</p>
    <p>{frequency.appearedDates.join(' / ')}</p>
  </details>}
</div>
<style>
  .study-meta{display:flex;flex-direction:column;align-items:flex-start;gap:5px;max-width:260px;min-width:0;flex:0 1 auto}
  .study-kind{font-size:12px;font-weight:700;color:var(--muted);line-height:1.4}
  .study-frequency{font-size:12px;line-height:1.6;max-width:100%;color:var(--muted);overflow-wrap:anywhere}
  .study-frequency summary{cursor:pointer;font-variant-numeric:tabular-nums;list-style-position:inside}
  .study-frequency p{font-size:12px;margin:5px 0;max-width:250px}
  @media(max-width:600px){.study-meta{max-width:100%;}.study-frequency{font-size:12px}}
</style>
