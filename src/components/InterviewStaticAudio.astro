<script>
  import { configuredAudioAssetUrl, localAudioAssetUrl } from '../lib/audioUrl';

  type AudioManifestItem = { text?: unknown; audio?: unknown };
  type InterviewManifest = {
    interview?: AudioManifestItem[];
    review?: AudioManifestItem[];
  };
  const normalize = (value: unknown): string => String(value || '').replace(/\s+/g, ' ').trim();
  const parts = window.location.pathname.split('/').filter(Boolean);
  const dailyIndex = parts.lastIndexOf('daily');
  const reportId = dailyIndex >= 0 ? parts[dailyIndex + 1] : '';

  if (reportId) {
    const manifestUrl = localAudioAssetUrl('japanese', reportId, 'interview-manifest.json');
    const manifestController = new AbortController();
    const manifestTimeout = window.setTimeout(() => manifestController.abort(), 10000);
    const audioMapPromise: Promise<Map<string, string>> = fetch(manifestUrl, {
      cache: 'no-cache', signal: manifestController.signal,
    })
      .then((response) => response.ok ? response.json() as Promise<InterviewManifest> : null)
      .then((manifest) => {
        const map = new Map<string, string>();
        for (const items of [manifest?.interview, manifest?.review]) {
          for (const item of Array.isArray(items) ? items : []) {
            if (typeof item?.text === 'string' && typeof item?.audio === 'string') {
              map.set(normalize(item.text), configuredAudioAssetUrl('japanese', reportId, item.audio));
            }
          }
        }
        return map;
      })
      .catch(() => new Map<string, string>())
      .finally(() => window.clearTimeout(manifestTimeout));

    const speechSupported = 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window;
    const synth = speechSupported ? window.speechSynthesis : null;
    let voices: SpeechSynthesisVoice[] = speechSupported && synth ? synth.getVoices() : [];
    let activeButton: HTMLButtonElement | null = null;
    let activeAudio: HTMLAudioElement | null = null;
    // Every stop/switch invalidates ALL earlier async work, including callbacks
    // for an older utterance on the same button.
    let playbackRequest = 0;
    const isCurrent = (request: number, button: HTMLButtonElement): boolean =>
      request === playbackRequest && activeButton === button && button.isConnected;

    const refreshVoices = (): void => {
      if (synth) voices = synth.getVoices();
    };
    if (synth) {
      refreshVoices();
      synth.addEventListener?.('voiceschanged', refreshVoices);
    }
    const japaneseVoice = (): SpeechSynthesisVoice | null => {
      const local = voices.find((voice) => voice.lang.toLowerCase() === 'ja-jp' && voice.localService);
      if (local) return local;
      const exact = voices.find((voice) => voice.lang.toLowerCase() === 'ja-jp');
      return exact || voices.find((voice) => voice.lang.toLowerCase().startsWith('ja')) || null;
    };

    const clearActive = (): void => {
      if (activeButton) {
        activeButton.classList.remove('is-speaking', 'is-loading');
        activeButton.setAttribute('aria-pressed', 'false');
        activeButton.removeAttribute('aria-busy');
        activeButton.querySelector('[data-audio-loading]')?.remove();
      }
      activeButton = null;
    };
    const stopAll = (): void => {
      playbackRequest += 1;
      const audio = activeAudio;
      activeAudio = null;
      if (audio) {
        audio.pause();
        audio.currentTime = 0;
      }
      if (synth) synth.cancel();
      clearActive();
    };
    const setActive = (button: HTMLButtonElement, loading = false): void => {
      activeButton = button;
      button.classList.toggle('is-speaking', !loading);
      button.classList.toggle('is-loading', loading);
      button.setAttribute('aria-pressed', 'true');
      button.removeAttribute('data-speech-unavailable');
      button.querySelector('[data-audio-loading]')?.remove();
      if (loading) {
        button.setAttribute('aria-busy', 'true');
        const status = document.createElement('span');
        status.dataset.audioLoading = '';
        status.setAttribute('aria-live', 'polite');
        status.textContent = document.documentElement.lang.startsWith('zh') ? ' · 加载中' : ' · 読み込み中';
        button.append(status);
      } else button.removeAttribute('aria-busy');
    };

    const speakFallback = (button: HTMLButtonElement, text: string, request: number): void => {
      if (!isCurrent(request, button)) return;
      if (!speechSupported || !synth) {
        button.dataset.speechUnavailable = 'true';
        clearActive();
        return;
      }
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'ja-JP';
      utterance.rate = 0.9;
      utterance.pitch = 1;
      utterance.volume = 1;
      const voice = japaneseVoice();
      if (voice) utterance.voice = voice;
      setActive(button);
      utterance.onend = () => { if (isCurrent(request, button)) clearActive(); };
      utterance.onerror = () => { if (isCurrent(request, button)) clearActive(); };
      try { synth.speak(utterance); }
      catch {
        if (isCurrent(request, button)) {
          button.dataset.speechUnavailable = 'true';
          clearActive();
        }
      }
    };

    const playAudio = (button: HTMLButtonElement, text: string, url: string, request: number): void => {
      if (!isCurrent(request, button)) return;
      const audio = new Audio(url);
      activeAudio = audio;
      setActive(button);
      let fallbackStarted = false;
      const fallback = (): void => {
        if (fallbackStarted || !isCurrent(request, button) || activeAudio !== audio) return;
        fallbackStarted = true;
        activeAudio = null;
        audio.pause();
        speakFallback(button, text, request);
      };
      audio.addEventListener('ended', () => {
        if (isCurrent(request, button) && activeAudio === audio) {
          activeAudio = null;
          clearActive();
        }
      }, { once: true });
      audio.addEventListener('error', fallback, { once: true });
      try {
        const result = audio.play();
        if (result && typeof result.catch === 'function') void result.catch(fallback);
      } catch { fallback(); }
    };

    document.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest('.report-speech-button');
      if (!(button instanceof HTMLButtonElement)) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      if (activeButton === button) {
        stopAll();
        return;
      }
      const text = normalize(button.dataset.speech || '');
      if (!text) return;
      stopAll();
      const request = playbackRequest;
      // Select BEFORE awaiting: clicking again while loading now cancels it.
      setActive(button, true);
      const map = await audioMapPromise;
      if (!isCurrent(request, button)) return;
      const audioUrl = map.get(text);
      if (audioUrl) playAudio(button, text, audioUrl, request);
      else speakFallback(button, text, request);
    }, true);

    // Keep listening after a bfcache restore; a second pagehide must stop too.
    window.addEventListener('pagehide', stopAll);
  }
</script>
