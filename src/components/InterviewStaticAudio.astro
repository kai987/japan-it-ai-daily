<script>
  import { configuredAudioAssetUrl, localAudioAssetUrl } from '../lib/audioUrl';

  type AudioManifestItem = { text?: unknown; audio?: unknown };
  type InterviewManifest = {
    interview?: AudioManifestItem[];
    review?: AudioManifestItem[];
  };

  const normalize = (value: unknown): string => String(value || '').replace(/\s+/g, ' ').trim();
  const parts = window.location.pathname.split('/').filter(Boolean);
  const dailyIndex = parts.lastIndexOf('daily');
  const reportId = dailyIndex >= 0 ? parts[dailyIndex + 1] : '';

  if (reportId) {
    const manifestUrl = localAudioAssetUrl('japanese', reportId, 'interview-manifest.json');

    const audioMapPromise: Promise<Map<string, string>> = fetch(manifestUrl, { cache: 'no-cache' })
      .then((response) => response.ok ? response.json() as Promise<InterviewManifest> : null)
      .then((manifest) => {
        const map = new Map<string, string>();
        for (const item of manifest?.interview || []) {
          if (item?.text && item?.audio) {
            map.set(normalize(item.text), configuredAudioAssetUrl('japanese', reportId, item.audio));
          }
        }
        for (const item of manifest?.review || []) {
          if (item?.text && item?.audio) {
            map.set(normalize(item.text), configuredAudioAssetUrl('japanese', reportId, item.audio));
          }
        }
        return map;
      })
      .catch(() => new Map<string, string>());

    const speechSupported = 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window;
    const synth = speechSupported ? window.speechSynthesis : null;
    let voices: SpeechSynthesisVoice[] = speechSupported && synth ? synth.getVoices() : [];
    let activeButton: HTMLButtonElement | null = null;
    let activeAudio: HTMLAudioElement | null = null;

    const refreshVoices = (): void => {
      if (synth) voices = synth.getVoices();
    };
    if (synth) {
      refreshVoices();
      synth.addEventListener?.('voiceschanged', refreshVoices);
    }

    const japaneseVoice = (): SpeechSynthesisVoice | null => {
      const local = voices.find((voice) => voice.lang.toLowerCase() === 'ja-jp' && voice.localService);
      if (local) return local;
      const exact = voices.find((voice) => voice.lang.toLowerCase() === 'ja-jp');
      if (exact) return exact;
      return voices.find((voice) => voice.lang.toLowerCase().startsWith('ja')) || null;
    };

    const clearActive = (): void => {
      if (activeButton) {
        activeButton.classList.remove('is-speaking');
        activeButton.setAttribute('aria-pressed', 'false');
      }
      activeButton = null;
    };

    const stopAll = (): void => {
      if (activeAudio) {
        activeAudio.pause();
        activeAudio.currentTime = 0;
      }
      activeAudio = null;
      if (synth) synth.cancel();
      clearActive();
    };

    const setActive = (button: HTMLButtonElement): void => {
      activeButton = button;
      button.classList.add('is-speaking');
      button.setAttribute('aria-pressed', 'true');
    };

    const speakFallback = (button: HTMLButtonElement, text: string): void => {
      if (!speechSupported || !synth) {
        button.dataset.speechUnavailable = 'true';
        clearActive();
        return;
      }
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'ja-JP';
      utterance.rate = 0.9;
      utterance.pitch = 1;
      utterance.volume = 1;
      const voice = japaneseVoice();
      if (voice) utterance.voice = voice;
      setActive(button);
      utterance.onend = () => { if (activeButton === button) clearActive(); };
      utterance.onerror = () => { if (activeButton === button) clearActive(); };
      synth.speak(utterance);
    };

    const playAudio = (button: HTMLButtonElement, text: string, url: string): void => {
      const audio = new Audio(url);
      activeAudio = audio;
      setActive(button);
      let fallbackStarted = false;
      const fallback = (): void => {
        if (fallbackStarted || activeAudio !== audio) return;
        fallbackStarted = true;
        activeAudio = null;
        clearActive();
        speakFallback(button, text);
      };
      audio.addEventListener('ended', () => {
        if (activeAudio === audio) {
          activeAudio = null;
          clearActive();
        }
      }, { once: true });
      audio.addEventListener('error', fallback, { once: true });
      const result = audio.play();
      if (result && typeof result.catch === 'function') result.catch(fallback);
    };

    document.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest('.report-speech-button');
      if (!(button instanceof HTMLButtonElement)) return;

      event.preventDefault();
      event.stopImmediatePropagation();

      if (activeButton === button) {
        stopAll();
        return;
      }

      const text = normalize(button.dataset.speech || '');
      if (!text) return;
      stopAll();
      const map = await audioMapPromise;
      const audioUrl = map.get(text);
      if (audioUrl) playAudio(button, text, audioUrl);
      else speakFallback(button, text);
    }, true);

    window.addEventListener('pagehide', stopAll, { once: true });
  }
</script>
