<script>
  import { configuredAudioAssetUrl, localAudioAssetUrl, versionAudioAssetUrl } from '../lib/audioUrl';
  import { createSpeechPlayback, fetchAudioManifest } from '../lib/speechPlayback';

  type AudioManifestItem = { text?: unknown; audio?: unknown; audioSha256?: unknown };
  type InterviewManifest = { interview?: AudioManifestItem[]; review?: AudioManifestItem[] };
  const normalize = (value: unknown): string => String(value || '').replace(/\s+/g, ' ').trim();
  const parts = window.location.pathname.split('/').filter(Boolean);
  const dailyIndex = parts.lastIndexOf('daily');
  const reportId = dailyIndex >= 0 ? parts[dailyIndex + 1] : '';

  if (reportId) {
    const audioMapPromise = fetchAudioManifest<InterviewManifest>(localAudioAssetUrl('japanese', reportId, 'interview-manifest.json'))
      .then((manifest) => {
        const map = new Map<string, string>();
        for (const items of [manifest?.interview, manifest?.review]) {
          for (const item of Array.isArray(items) ? items : []) {
            if (typeof item?.text === 'string' && typeof item?.audio === 'string' && /^[\w-]+\.mp3$/.test(item.audio)) {
              map.set(normalize(item.text), versionAudioAssetUrl(configuredAudioAssetUrl('japanese', reportId, item.audio), item.audioSha256));
            }
          }
        }
        return map;
      });
    const playback = createSpeechPlayback();
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest('.report-speech-button');
      if (!(button instanceof HTMLButtonElement)) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      void playback.toggle(button, normalize(button.dataset.speech), async () => (await audioMapPromise).get(normalize(button.dataset.speech)) || null);
    }, true);
  }
</script>
