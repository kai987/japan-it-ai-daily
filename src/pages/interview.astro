---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const reports = (await getCollection('daily')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const stripInlineMarkdown = (value: string) => value
  .replace(/\*\*/g, '')
  .replace(/__/g, '')
  .replace(/^`|`$/g, '')
  .trim();

/**
 * Extract a Markdown section while preserving nested headings.
 *
 * Legacy reports use `### 面接で使えるポイント`, while newer reports use
 * `## 3. 面接で使えるポイント` with several `### 话题 ...` children.
 * The old regex stopped at every h2/h3, which discarded all nested content.
 */
const extractSection = (body: string, title: string) => {
  const lines = body.split(/\r?\n/);
  const needle = title.replace(/\s+/g, '').toLocaleLowerCase('ja-JP');
  let start = -1;
  let sectionDepth = 0;

  for (let index = 0; index < lines.length; index += 1) {
    const match = lines[index].match(/^(#{1,6})\s+(.+?)\s*$/);
    if (!match) continue;
    const headingText = match[2]
      .replace(/^\d+[.．、)]\s*/, '')
      .replace(/\s+/g, '')
      .toLocaleLowerCase('ja-JP');
    if (!headingText.includes(needle)) continue;
    start = index + 1;
    sectionDepth = match[1].length;
    break;
  }

  if (start < 0) return '';

  let end = lines.length;
  for (let index = start; index < lines.length; index += 1) {
    const match = lines[index].match(/^(#{1,6})\s+/);
    if (match && match[1].length <= sectionDepth) {
      end = index;
      break;
    }
  }

  return lines.slice(start, end).join('\n').trim();
};

const collectQuoteAfter = (lines: string[], labelIndex: number) => {
  const quoteLines: string[] = [];
  let started = false;

  for (let index = labelIndex + 1; index < lines.length; index += 1) {
    const line = lines[index].trim();
    if (!line && !started) continue;
    if (line.startsWith('>')) {
      started = true;
      const text = line.replace(/^>\s?/, '').trim();
      if (text) quoteLines.push(text);
      continue;
    }
    if (started || /^(#{1,6})\s+/.test(line) || /^\*\*.+\*\*/.test(line)) break;
  }

  return quoteLines.join(' ').trim();
};

const extractAnswers = (body: string) => {
  const section = extractSection(body, '面接で使えるポイント');
  if (!section) return [];
  const lines = section.split(/\r?\n/);
  const answers: string[] = [];

  // New format (2026-08-27+): each topic contains a labelled 30-second answer.
  lines.forEach((line, index) => {
    const label = stripInlineMarkdown(line).replace(/[：:]$/, '');
    if (!/(?:約|约)\s*30\s*秒.*(?:回答|答え)/i.test(label)) return;
    const answer = collectQuoteAfter(lines, index);
    if (answer) answers.push(answer);
  });

  if (answers.length) return Array.from(new Set(answers));

  // Legacy format: the interview section consists directly of answer quotes.
  return Array.from(new Set(
    lines
      .map((line) => line.trim())
      .filter((line) => line.startsWith('>'))
      .map((line) => line.replace(/^>\s*/, '').trim())
      .filter(Boolean)
  ));
};

const cleanReviewPoints = (value: string) => stripInlineMarkdown(value)
  .replace(/^(?:回答要点|回答ポイント|要点)\s*[：:]\s*/, '')
  .trim();

const extractReviewCards = (body: string) => {
  const section = extractSection(body, '面试复习卡');
  if (!section) return [];
  const lines = section.split(/\r?\n/);
  const cards: Array<{ question: string; points: string }> = [];

  // New format: ### Q1 -> quoted question -> 回答要点：...
  for (let index = 0; index < lines.length; index += 1) {
    if (!/^#{3,6}\s*Q\s*\d+/i.test(lines[index].trim())) continue;
    let end = lines.length;
    for (let cursor = index + 1; cursor < lines.length; cursor += 1) {
      if (/^#{3,6}\s*Q\s*\d+/i.test(lines[cursor].trim())) {
        end = cursor;
        break;
      }
    }

    const block = lines.slice(index + 1, end);
    const question = block
      .map((line) => line.trim())
      .find((line) => line.startsWith('>'))
      ?.replace(/^>\s*/, '')
      .trim() ?? '';
    const pointsLine = block
      .map((line) => line.trim())
      .find((line) => /^(?:回答要点|回答ポイント|要点)\s*[：:]/.test(stripInlineMarkdown(line)));
    const points = pointsLine ? cleanReviewPoints(pointsLine) : '';

    if (question) cards.push({ question, points });
    index = end - 1;
  }

  if (cards.length) return cards;

  // Legacy format: - 質問 → 要点
  return lines
    .map((line) => line.trim())
    .filter((line) => line.startsWith('-'))
    .map((line) => {
      const clean = line.replace(/^-\s*/, '');
      const parts = clean.split(/\s*→\s*/);
      return {
        question: stripInlineMarkdown(parts[0] ?? ''),
        points: stripInlineMarkdown(parts.slice(1).join(' → ') ?? ''),
      };
    })
    .filter((item) => item.question);
};

const categoryRules = [
  { label: 'AI Agent', test: /Agent|Claude Code|Codex|Copilot|LLM|Model|VLM|Harness/i },
  { label: 'MCP / RAG', test: /MCP|RAG|Context|Retrieval|GraphRAG|Knowledge/i },
  { label: 'Security', test: /Security|IAM|Permission|Vulnerab|Guardrail|Sandbox|Identity|SBOM/i },
  { label: 'Frontend', test: /React|Next|Frontend|Bun|TypeScript|TypeSpec|Web/i },
  { label: 'Cloud / SRE', test: /AWS|Cloud|SRE|AIOps|Bedrock|Aurora|Database|DevOps|Kubernetes/i },
  { label: '企业 AI', test: /Enterprise|Governance|ROI|Transformation|LLMOps|FinOps|人材|企業|組織/i },
];

const interviewDays = reports
  .map((report) => {
    const body = ((report as any).body ?? '') as string;
    const answers = extractAnswers(body);
    const reviewCards = extractReviewCards(body);
    const topicText = [report.data.description, ...report.data.topics, ...report.data.top.map((item) => `${item.title} ${item.topic}`)].join(' ');
    const categories = categoryRules.filter((rule) => rule.test.test(topicText)).map((rule) => rule.label);
    return { report, answers, reviewCards, categories: categories.length ? categories : ['AI Agent'] };
  })
  .filter((day) => day.answers.length > 0 || day.reviewCards.length > 0);

const totalAnswers = interviewDays.reduce((sum, day) => sum + day.answers.length, 0);
const totalQuestions = interviewDays.reduce((sum, day) => sum + day.reviewCards.length, 0);
const availableCategories = categoryRules
  .map((rule) => rule.label)
  .filter((label) => interviewDays.some((day) => day.categories.includes(label)));

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Interview · Japan IT / AI Daily" description="日本AI・AI×Webエンジニア面接で使える技術回答を、毎日のIT/AIニュースから整理。">
  <section class="hero interview-hero">
    <div class="container interview-hero-grid">
      <div>
        <div class="eyebrow">Interview Knowledge Base</div>
        <h1>面接で使えるポイント</h1>
        <p>每天把日本 IT / AI 日报中的技术判断，积累成可以直接复习的日语面试回答与 Quick Review。</p>
      </div>
      <div class="interview-stats" aria-label="Interview knowledge stats">
        <div><strong>{interviewDays.length}</strong><span>学习日</span></div>
        <div><strong>{totalAnswers}</strong><span>回答例</span></div>
        <div><strong>{totalQuestions}</strong><span>复习题</span></div>
      </div>
    </div>
  </section>

  <section class="section interview-section">
    <div class="container">
      <div class="interview-toolbar" id="interview-list-start">
        <div>
          <h2>历史面试素材</h2>
          <p>按主题筛选。所有内容均来自对应日期日报中的「面接で使えるポイント」与「面试复习卡」。</p>
        </div>
        <div class="interview-filters" role="group" aria-label="Interview topic filters">
          <button class="interview-filter" type="button" data-filter="all" aria-pressed="true">全部</button>
          {availableCategories.map((category) => (
            <button class="interview-filter" type="button" data-filter={category} aria-pressed="false">{category}</button>
          ))}
        </div>
      </div>

      <div class="interview-feed">
        {interviewDays.map(({ report, answers, reviewCards, categories }) => (
          <article class="interview-day" data-categories={categories.join('|')}>
            <header class="interview-day-header">
              <div>
                <div class="interview-date">{report.data.date.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })}</div>
                <h2>{report.data.description}</h2>
                <div class="tags interview-tags">
                  {categories.map((category) => <span class="tag">{category}</span>)}
                </div>
              </div>
              <a class="daily-link" href={`${base}daily/${report.id}/`}>当天日报 →</a>
            </header>

            {answers.length > 0 && (
              <div class="interview-answer-grid">
                {answers.map((answer, index) => (
                  <section class="interview-answer-card">
                    <div class="answer-card-top">
                      <span class="answer-index">{String(index + 1).padStart(2, '0')}</span>
                      <span class="answer-label">面接回答例</span>
                    </div>
                    <p lang="ja">{answer}</p>
                  </section>
                ))}
              </div>
            )}

            {reviewCards.length > 0 && (
              <section class="quick-review">
                <div class="quick-review-heading">
                  <h3>Quick Review</h3>
                  <span>{reviewCards.length} questions</span>
                </div>
                <div class="review-list">
                  {reviewCards.map((item) => (
                    <div class="review-row">
                      <div class="review-q"><span>Q</span><p lang="ja">{item.question}</p></div>
                      {item.points && <div class="review-points"><span>KEY</span><p>{item.points}</p></div>}
                    </div>
                  ))}
                </div>
              </section>
            )}
          </article>
        ))}
      </div>

      <p class="interview-empty" hidden>这个主题暂时没有面试素材。</p>

      <nav class="interview-pagination" aria-label="面试素材分页" hidden>
        <button class="pagination-nav pagination-prev" type="button" aria-label="上一页">← 上一页</button>
        <div class="pagination-pages" aria-label="页码"></div>
        <button class="pagination-nav pagination-next" type="button" aria-label="下一页">下一页 →</button>
        <div class="pagination-status" aria-live="polite"></div>
      </nav>
    </div>
  </section>

  <script is:inline>
    (() => {
      const PAGE_SIZE = 10;
      const buttons = Array.from(document.querySelectorAll('.interview-filter'));
      const days = Array.from(document.querySelectorAll('.interview-day')).filter((day) => day instanceof HTMLElement);
      const empty = document.querySelector('.interview-empty');
      const pagination = document.querySelector('.interview-pagination');
      const pageContainer = document.querySelector('.pagination-pages');
      const prev = document.querySelector('.pagination-prev');
      const next = document.querySelector('.pagination-next');
      const status = document.querySelector('.pagination-status');
      const listStart = document.querySelector('#interview-list-start');
      if (!buttons.length || !days.length) return;

      let currentFilter = 'all';
      let currentPage = 1;

      const getFilteredDays = () => days.filter((day) => {
        const categories = (day.dataset.categories || '').split('|');
        return currentFilter === 'all' || categories.includes(currentFilter);
      });

      const scrollToList = () => {
        if (!(listStart instanceof HTMLElement)) return;
        listStart.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };

      const pageNumbers = (totalPages, page) => {
        if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);
        const values = new Set([1, totalPages, page - 1, page, page + 1]);
        return Array.from(values)
          .filter((value) => value >= 1 && value <= totalPages)
          .sort((a, b) => a - b);
      };

      const renderPagination = (filteredDays) => {
        const totalItems = filteredDays.length;
        const totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
        currentPage = Math.min(currentPage, totalPages);

        if (pagination instanceof HTMLElement) pagination.hidden = totalItems <= PAGE_SIZE;
        if (prev instanceof HTMLButtonElement) prev.disabled = currentPage <= 1;
        if (next instanceof HTMLButtonElement) next.disabled = currentPage >= totalPages;

        if (pageContainer instanceof HTMLElement) {
          pageContainer.replaceChildren();
          const pages = pageNumbers(totalPages, currentPage);
          let previousPage = 0;
          pages.forEach((page) => {
            if (previousPage && page - previousPage > 1) {
              const ellipsis = document.createElement('span');
              ellipsis.className = 'pagination-ellipsis';
              ellipsis.textContent = '…';
              ellipsis.setAttribute('aria-hidden', 'true');
              pageContainer.appendChild(ellipsis);
            }
            const pageButton = document.createElement('button');
            pageButton.type = 'button';
            pageButton.className = 'pagination-page';
            pageButton.textContent = String(page);
            pageButton.setAttribute('aria-label', `第 ${page} 页`);
            if (page === currentPage) pageButton.setAttribute('aria-current', 'page');
            pageButton.addEventListener('click', () => {
              if (page === currentPage) return;
              currentPage = page;
              render(true);
            });
            pageContainer.appendChild(pageButton);
            previousPage = page;
          });
        }

        if (status instanceof HTMLElement) {
          if (!totalItems) {
            status.textContent = '';
          } else {
            const start = (currentPage - 1) * PAGE_SIZE + 1;
            const end = Math.min(currentPage * PAGE_SIZE, totalItems);
            status.textContent = `${start}–${end} / ${totalItems}`;
          }
        }
      };

      const render = (shouldScroll = false) => {
        const filteredDays = getFilteredDays();
        const pageStart = (currentPage - 1) * PAGE_SIZE;
        const pageEnd = pageStart + PAGE_SIZE;
        const visibleSet = new Set(filteredDays.slice(pageStart, pageEnd));

        days.forEach((day) => {
          day.hidden = !visibleSet.has(day);
        });

        if (empty instanceof HTMLElement) empty.hidden = filteredDays.length !== 0;
        buttons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          button.setAttribute('aria-pressed', String(button.dataset.filter === currentFilter));
        });

        renderPagination(filteredDays);
        if (shouldScroll) scrollToList();
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          if (!(button instanceof HTMLButtonElement)) return;
          currentFilter = button.dataset.filter || 'all';
          currentPage = 1;
          render(false);
        });
      });

      if (prev instanceof HTMLButtonElement) {
        prev.addEventListener('click', () => {
          if (currentPage <= 1) return;
          currentPage -= 1;
          render(true);
        });
      }
      if (next instanceof HTMLButtonElement) {
        next.addEventListener('click', () => {
          const totalPages = Math.ceil(getFilteredDays().length / PAGE_SIZE);
          if (currentPage >= totalPages) return;
          currentPage += 1;
          render(true);
        });
      }

      render(false);
    })();
  </script>

  <style>
    .interview-hero{padding:56px 0 38px}
    .interview-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:54px;align-items:end}
    .interview-hero h1{font-size:clamp(2.7rem,6vw,4.8rem);max-width:760px}
    .interview-stats{display:grid;grid-template-columns:repeat(3,minmax(92px,1fr));gap:10px;min-width:330px}
    .interview-stats div{display:grid;gap:5px;padding:18px;border:1px solid var(--border);border-radius:14px;background:var(--surface-elevated)}
    .interview-stats strong{font-size:1.65rem;line-height:1;color:var(--text)}
    .interview-stats span{font-size:.78rem;color:var(--muted)}
    .interview-section{padding-top:34px}
    .interview-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:30px;align-items:end;margin-bottom:26px;scroll-margin-top:92px}
    .interview-toolbar h2{margin:0 0 5px;font-size:1.45rem}
    .interview-toolbar p{margin:0;color:var(--muted);font-size:.9rem}
    .interview-filters{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:7px;max-width:560px}
    .interview-filter{border:1px solid var(--border);border-radius:999px;padding:7px 12px;background:var(--surface-elevated);color:var(--muted);cursor:pointer;font-size:.82rem;transition:.16s ease}
    .interview-filter:hover{border-color:var(--accent);color:var(--accent)}
    .interview-filter[aria-pressed='true']{border-color:var(--accent);background:var(--accent);color:#fff}
    .interview-feed{display:grid;gap:30px}
    .interview-day{padding:28px;border:1px solid var(--border);border-radius:18px;background:var(--surface-elevated);box-shadow:var(--shadow)}
    .interview-day[hidden]{display:none}
    .interview-day-header{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;padding-bottom:22px;border-bottom:1px solid var(--border)}
    .interview-date{font-size:.78rem;color:var(--accent);font-weight:760;letter-spacing:.06em}
    .interview-day-header h2{max-width:780px;margin:6px 0 0;font-size:1.14rem;line-height:1.55}
    .interview-tags{margin-top:12px}
    .interview-tags .tag{padding:4px 8px;font-size:.72rem}
    .daily-link{flex:0 0 auto;color:var(--accent);font-size:.84rem;font-weight:700;padding-top:3px}
    .interview-answer-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:20px}
    .interview-answer-card{margin:0;padding:20px;border:1px solid var(--border);border-radius:14px;background:var(--surface)}
    .answer-card-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}
    .answer-index{font-size:.76rem;color:var(--accent);font-weight:800}
    .answer-label{font-size:.72rem;color:var(--muted);font-weight:700;letter-spacing:.04em}
    .interview-answer-card p{margin:0;font-size:.96rem;line-height:1.9;font-weight:560}
    .quick-review{margin-top:22px;padding-top:20px;border-top:1px solid var(--border)}
    .quick-review-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
    .quick-review-heading h3{margin:0;font-size:.95rem}
    .quick-review-heading span{font-size:.75rem;color:var(--muted)}
    .review-list{display:grid}
    .review-row{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:18px;padding:13px 0;border-top:1px solid var(--border)}
    .review-q,.review-points{display:flex;gap:10px;align-items:flex-start}
    .review-q span,.review-points span{flex:0 0 auto;margin-top:3px;font-size:.68rem;font-weight:800;color:var(--accent)}
    .review-points span{color:var(--muted)}
    .review-q p,.review-points p{margin:0;font-size:.87rem;line-height:1.65}
    .review-points p{color:var(--muted)}
    .interview-empty{padding:40px 0;text-align:center;color:var(--muted)}
    .interview-pagination{display:grid;grid-template-columns:auto minmax(0,1fr) auto;grid-template-areas:"prev pages next" "status status status";align-items:center;gap:12px;margin-top:34px;padding-top:24px;border-top:1px solid var(--border)}
    .interview-pagination[hidden]{display:none}
    .pagination-prev{grid-area:prev}.pagination-pages{grid-area:pages}.pagination-next{grid-area:next}.pagination-status{grid-area:status}
    .pagination-pages{display:flex;align-items:center;justify-content:center;gap:6px;min-width:0}
    .pagination-nav,.pagination-page{border:1px solid var(--border);background:var(--surface-elevated);color:var(--subtle-text);cursor:pointer;font-weight:680;transition:.16s ease}
    .pagination-nav{min-height:40px;border-radius:10px;padding:8px 13px;font-size:.82rem;white-space:nowrap}
    .pagination-page{width:40px;height:40px;border-radius:10px;padding:0;font-size:.84rem}
    .pagination-nav:hover:not(:disabled),.pagination-page:hover{border-color:var(--accent);color:var(--accent)}
    .pagination-page[aria-current='page']{border-color:var(--accent);background:var(--accent);color:#fff}
    .pagination-nav:disabled{opacity:.38;cursor:not-allowed}
    .pagination-ellipsis{display:inline-grid;place-items:center;width:24px;color:var(--muted)}
    .pagination-status{text-align:center;color:var(--muted);font-size:.78rem;font-variant-numeric:tabular-nums}
    @media(max-width:900px){
      .interview-hero-grid,.interview-toolbar{grid-template-columns:1fr}
      .interview-stats{min-width:0;max-width:430px}
      .interview-filters{justify-content:flex-start;max-width:none}
    }
    @media(max-width:700px){
      .interview-hero{padding:38px 0 28px}
      .interview-hero h1{font-size:clamp(2.2rem,12vw,3.4rem)}
      .interview-stats{grid-template-columns:repeat(3,1fr);gap:7px}
      .interview-stats div{padding:13px 11px}
      .interview-stats strong{font-size:1.35rem}
      .interview-day{padding:18px;border-radius:14px}
      .interview-day-header{display:grid;gap:12px}
      .daily-link{justify-self:start}
      .interview-answer-grid{grid-template-columns:1fr}
      .review-row{grid-template-columns:1fr;gap:9px}
      .interview-filter{padding:7px 10px;font-size:.78rem}
      .interview-pagination{grid-template-columns:1fr 1fr;grid-template-areas:"prev next" "pages pages" "status status";gap:10px}
      .pagination-pages{overflow-x:auto;justify-content:flex-start;padding-bottom:2px;scrollbar-width:none}
      .pagination-pages::-webkit-scrollbar{display:none}
      .pagination-prev,.pagination-next{width:100%}
      .pagination-page{flex:0 0 38px;width:38px;height:38px}
    }
  </style>
</BaseLayout>