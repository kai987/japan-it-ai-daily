---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const reports = (await getCollection('daily')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const latest = reports[0];
const top = latest?.data.top ?? [];
---
<BaseLayout title="重点知识 · Japan IT / AI Daily">
  <section class="hero">
    <div class="container">
      <div class="eyebrow">Important Points</div>
      <h1>B. 重点知识｜重要ポイント</h1>
      <p>把每日 Top 5 的技术内容整理成适合复习和日本 AI / AI×Web 面试准备的核心知识点。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {latest ? (
        <>
          <div class="section-title">
            <div>
              <div class="meta">{latest.data.date.toLocaleDateString('ja-JP')}</div>
              <h2>最新一期重点知识</h2>
            </div>
            <a href={`${base}daily/${latest.id}/`}>查看完整日报 →</a>
          </div>
          <div class="top-list">
            {top.slice(0,5).map((item:any, i:number) => (
              <article class="top-item">
                <div class="rank">{String(i+1).padStart(2,'0')}</div>
                <div>
                  <h3>{item.title}</h3>
                  <div class="meta">{item.source}{item.topic ? ` · ${item.topic}` : ''}</div>
                  {item.why && <div class="why">{item.why}</div>}
                </div>
              </article>
            ))}
          </div>
        </>
      ) : (
        <div class="panel">第一份日报发布后，这里会自动显示重点知识。</div>
      )}
    </div>
  </section>

  <section class="section" style="background:var(--surface)">
    <div class="container">
      <div class="section-title"><h2>历史重点知识</h2><a href={`${base}archive/`}>查看全部日报 →</a></div>
      <div class="archive-list">
        {reports.slice(0,12).map((report)=>(
          <a class="archive-row" href={`${base}daily/${report.id}/`}>
            <div class="meta">{report.data.date.toLocaleDateString('ja-JP')}</div>
            <div><strong>{report.data.title}</strong><div class="meta">{report.data.description}</div></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
