---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const reports = await getCollection('daily');
const counts = new Map<string, number>();
for (const report of reports) for (const topic of report.data.topics) counts.set(topic,(counts.get(topic)||0)+1);
const topics = [...counts.entries()].sort((a,b)=>b[1]-a[1]);
---
<BaseLayout title="Topics · Japan IT / AI Daily">
  <section class="hero"><div class="container"><div class="eyebrow">Topics</div><h1>技术主题</h1><p>从每日新闻中沉淀长期可复习的 AI / Web / Cloud / Security 主题。</p></div></section>
  <section class="section"><div class="container grid-two">
    {topics.length ? topics.map(([topic,count]) => <div class="panel"><h3>{topic}</h3><p>{count} 期日报提及</p></div>) : <div class="panel"><h3>AI Agent / MCP / RAG / Security</h3><p>随着日报积累，这里会自动形成主题索引。</p></div>}
  </div></section>
</BaseLayout>
