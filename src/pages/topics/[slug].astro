---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { featuredTopics, topicMatches } from '../../lib/topics';
import { getJapaneseArticleTitle } from '../../lib/articleTitles';
import { getSafeExternalUrl } from '../../lib/urls';

export function getStaticPaths() {
  return featuredTopics.map((topic) => ({
    params: { slug: topic.key },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const base = import.meta.env.BASE_URL;
const reports = (await getCollection('daily')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const matches = reports.flatMap((report) =>
  (report.data.top ?? [])
    .filter((item:any) => topicMatches(item, topic))
    .map((item:any) => ({ item, report })),
);
---
<BaseLayout title={`${topic.label} · Topics · Japan IT / AI Daily`} description={topic.description}>
  <section class="hero topic-detail-hero">
    <div class="container">
      <a class="eyebrow topic-back" href={`${base}topics/`}>← EXPLORE TOPICS</a>
      <h1>{topic.label}</h1>
      <p>{topic.description}</p>
      <div class="tags"><span class="tag">{matches.length} {matches.length === 1 ? 'article' : 'articles'}</span></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="topic-article-list">
        {matches.length ? matches.map(({ item, report }) => {
          const safeUrl = getSafeExternalUrl(item.url);
          const href = safeUrl ?? `${base}daily/${report.id}/`;
          const external = Boolean(safeUrl);
          const displayTitle = getJapaneseArticleTitle(item);
          return (
            <a class="topic-article-row" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
              <div class="topic-article-date">{report.data.date.toLocaleDateString('ja-JP')}</div>
              <div>
                <h2>{displayTitle}</h2>
                <div class="meta">{item.source}{item.topic ? ` · ${item.topic}` : ''}</div>
                {item.why && <p>{item.why}</p>}
              </div>
              <span class="topic-article-action">{external ? '原文 ↗' : '日报 →'}</span>
            </a>
          );
        }) : (
          <div class="panel"><h3>暂无匹配文章</h3><p>随着日报继续更新，这个主题页会自动增加内容。</p></div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
