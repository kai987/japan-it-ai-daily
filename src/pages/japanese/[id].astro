---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const lessons = await getCollection('japanese');
  return lessons.map((lesson) => ({ params: { id: lesson.id }, props: { lesson } }));
}

const { lesson } = Astro.props;
const { Content, headings } = await render(lesson);
const base = import.meta.env.BASE_URL;
const hasStructuredCards = lesson.data.vocabulary.length > 0 || lesson.data.grammar.length > 0;
const legacyTocHeadings = headings.filter((heading:any) => heading.depth < 4);
const jlptOrder = ['N5/N4', 'N3', 'N2', 'N1'];
const vocabGroups = jlptOrder
  .map((level) => ({ level, items: lesson.data.vocabulary.filter((item) => item.level === level) }))
  .filter((group) => group.items.length > 0);
---
<BaseLayout title={`${lesson.data.title} · Japan IT / AI Daily`} description={lesson.data.description}>
  <div class="container report-layout lesson-detail">
    <article class="prose lesson-prose">
      <div class="eyebrow">{lesson.data.date.toLocaleDateString('ja-JP')} · JLPT + IT日本語</div>
      <h1>{lesson.data.title}</h1>
      <p class="meta">{lesson.data.description}</p>
      <div class="tags">{lesson.data.levels.map((level:string) => <span class="tag">{level}</span>)}</div>
      <p class="learning-back"><a href={`${base}japanese/`}>← 日本語学习一覧へ</a></p>

      {hasStructuredCards ? (
        <Fragment>
          <section class="study-section" id="c-1-jlpt-vocabulary">
            <div class="study-section-heading">
              <div>
                <div class="entry-kicker">C-1 · Vocabulary</div>
                <h2>JLPT 词汇（参考等级）</h2>
              </div>
              <p>JMdict/EDICT 可用于辅助校对读音、词性和基本词义；JLPT 等级仅作为学习参考。</p>
            </div>

            {vocabGroups.map((group) => (
              <section class="study-level-group" id={`vocab-${group.level.toLowerCase().replace('/','-')}`}>
                <div class="study-level-title"><span>{group.level}</span><small>{group.items.length} words</small></div>
                <div class="study-card-grid">
                  {group.items.map((item) => (
                    <article class="study-card vocabulary-card">
                      <header class="study-card-header">
                        <div>
                          <div class="study-term-line">
                            <h3>{item.term}<span class="reading">（{item.reading}）</span></h3>
                            <button
                              class="speech-button"
                              type="button"
                              data-speech={item.reading || item.term}
                              data-speech-kind="word"
                              aria-label={`${item.term}の発音を再生`}
                              aria-pressed="false"
                              title="词汇读音"
                            >
                              <svg class="speech-icon-speaker" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M11 5 7 9H4v6h3l4 4V5Z"></path>
                                <path d="M15 9.5a4 4 0 0 1 0 5M17.5 7a7.3 7.3 0 0 1 0 10"></path>
                              </svg>
                              <svg class="speech-icon-stop" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="7" y="7" width="10" height="10" rx="1"></rect>
                              </svg>
                            </button>
                          </div>
                          <div class="study-pos">{item.partOfSpeech}</div>
                        </div>
                        <span class="level-badge">参考：{item.level}</span>
                      </header>

                      <div class="study-field">
                        <span class="study-label">中文</span>
                        <p class="study-meaning">{item.meaningZh}</p>
                      </div>

                      {item.collocations.length > 0 && (
                        <div class="study-field">
                          <span class="study-label">常用搭配</span>
                          <div class="phrase-list">
                            {item.collocations.map((phrase) => <span>{phrase}</span>)}
                          </div>
                        </div>
                      )}

                      <div class="study-field">
                        <span class="study-label">技术语境</span>
                        <p>{item.noteZh}</p>
                      </div>

                      <div class="example-box">
                        <div class="example-label-row">
                          <span class="study-label">IT / AI 例句</span>
                          <button
                            class="speech-button"
                            type="button"
                            data-speech={item.exampleJa}
                            data-speech-kind="example"
                            aria-label="例文を読み上げる"
                            aria-pressed="false"
                            title="例句朗读"
                          >
                            <svg class="speech-icon-speaker" viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M11 5 7 9H4v6h3l4 4V5Z"></path>
                              <path d="M15 9.5a4 4 0 0 1 0 5M17.5 7a7.3 7.3 0 0 1 0 10"></path>
                            </svg>
                            <svg class="speech-icon-stop" viewBox="0 0 24 24" aria-hidden="true">
                              <rect x="7" y="7" width="10" height="10" rx="1"></rect>
                            </svg>
                          </button>
                        </div>
                        <p lang="ja">{item.exampleJa}</p>
                        {item.exampleZh && <small>{item.exampleZh}</small>}
                      </div>

                      {item.nuanceZh && (
                        <div class="nuance-note">
                          <span class="study-label">表达提示</span>
                          <p>{item.nuanceZh}</p>
                        </div>
                      )}
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </section>

          {lesson.data.technicalTerms.length > 0 && (
            <section class="study-section" id="c-2-it-ai-terms">
              <div class="study-section-heading">
                <div>
                  <div class="entry-kicker">C-2 · Technical Terms</div>
                  <h2>IT / AI 专业词汇</h2>
                </div>
                <p>技术外来语和复合专业词不强行划入 JLPT 等级。</p>
              </div>
              <div class="technical-term-grid">
                {lesson.data.technicalTerms.map((item) => (
                  <article class="technical-term-card">
                    <h3>{item.term}</h3>
                    {item.japanese && <div class="meta">{item.japanese}</div>}
                    <p><strong>{item.meaningZh}</strong></p>
                    <p>{item.contextZh}</p>
                  </article>
                ))}
              </div>
            </section>
          )}

          <section class="study-section" id="c-3-jlpt-grammar">
            <div class="study-section-heading">
              <div>
                <div class="entry-kicker">C-3 · Grammar</div>
                <h2>JLPT 语法（参考等级）</h2>
              </div>
              <p>优先选择技术说明、比较优缺点和面试回答中复用率高的表达。</p>
            </div>
            <div class="grammar-card-grid">
              {lesson.data.grammar.map((item) => (
                <article class="study-card grammar-card">
                  <header class="study-card-header">
                    <h3>{item.pattern}</h3>
                    <span class="level-badge">参考：{item.level}</span>
                  </header>
                  <div class="study-field">
                    <span class="study-label">中文</span>
                    <p class="study-meaning">{item.meaningZh}</p>
                  </div>
                  <div class="grammar-structure"><span>结构</span><code>{item.structure}</code></div>
                  <div class="study-field">
                    <span class="study-label">使用场景</span>
                    <p>{item.usageZh}</p>
                  </div>
                  <div class="example-box">
                    <span class="study-label">IT / AI 例句</span>
                    <p lang="ja">{item.exampleJa}</p>
                    {item.exampleZh && <small>{item.exampleZh}</small>}
                  </div>
                  {item.noteZh && (
                    <div class="nuance-note"><span class="study-label">注意</span><p>{item.noteZh}</p></div>
                  )}
                </article>
              ))}
            </div>
          </section>

          {(lesson.data.mustRememberWords.length > 0 || lesson.data.mustRememberGrammar.length > 0) && (
            <section class="study-section remember-section" id="c-4-must-remember">
              <div class="entry-kicker">C-4 · Review</div>
              <h2>今日必背</h2>
              {lesson.data.mustRememberWords.length > 0 && (
                <div class="remember-row"><strong>10词</strong><div class="remember-chips">{lesson.data.mustRememberWords.map((item) => <span>{item}</span>)}</div></div>
              )}
              {lesson.data.mustRememberGrammar.length > 0 && (
                <div class="remember-row"><strong>5语法</strong><div class="remember-chips">{lesson.data.mustRememberGrammar.map((item) => <span>{item}</span>)}</div></div>
              )}
            </section>
          )}
        </Fragment>
      ) : (
        <div class="legacy-lesson"><Content /></div>
      )}
    </article>

    <aside class="toc" aria-label="On this page">
      <h4>目次</h4>
      {hasStructuredCards ? (
        <Fragment>
          <a href="#c-1-jlpt-vocabulary">C-1. JLPT 词汇</a>
          {lesson.data.technicalTerms.length > 0 && <a href="#c-2-it-ai-terms">C-2. IT / AI 专业词汇</a>}
          <a href="#c-3-jlpt-grammar">C-3. JLPT 语法</a>
          {(lesson.data.mustRememberWords.length > 0 || lesson.data.mustRememberGrammar.length > 0) && <a href="#c-4-must-remember">C-4. 今日必背</a>}
        </Fragment>
      ) : (
        legacyTocHeadings.map((heading:any)=><a href={`#${heading.slug}`}>{heading.text}</a>)
      )}
    </aside>
  </div>

  <script is:inline>
    (() => {
      const buttons = Array.from(document.querySelectorAll('.speech-button'));
      if (!buttons.length) return;

      const speechSupported = 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window;
      const synth = speechSupported ? window.speechSynthesis : null;
      let voices = speechSupported ? synth.getVoices() : [];
      let activeButton = null;
      let activeAudio = null;

      const refreshVoices = () => {
        if (synth) voices = synth.getVoices();
      };

      const japaneseVoice = () => {
        const exactLocal = voices.find((voice) => voice.lang.toLowerCase() === 'ja-jp' && voice.localService);
        if (exactLocal) return exactLocal;
        const exact = voices.find((voice) => voice.lang.toLowerCase() === 'ja-jp');
        if (exact) return exact;
        return voices.find((voice) => voice.lang.toLowerCase().startsWith('ja')) || null;
      };

      const setActive = (button) => {
        activeButton = button;
        button.classList.add('is-speaking');
        button.setAttribute('aria-pressed', 'true');
      };

      const clearActive = () => {
        if (activeButton instanceof HTMLButtonElement) {
          activeButton.classList.remove('is-speaking');
          activeButton.setAttribute('aria-pressed', 'false');
        }
        activeButton = null;
      };

      const stopAll = () => {
        if (activeAudio instanceof HTMLAudioElement) {
          activeAudio.pause();
          activeAudio.currentTime = 0;
        }
        activeAudio = null;
        if (synth) synth.cancel();
        clearActive();
      };

      const speakFallback = (button, text) => {
        if (!speechSupported || !synth) {
          button.dataset.speechUnavailable = 'true';
          clearActive();
          return;
        }

        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'ja-JP';
        utterance.rate = button.dataset.speechKind === 'word' ? 0.82 : 0.9;
        utterance.pitch = 1;
        utterance.volume = 1;
        const voice = japaneseVoice();
        if (voice) utterance.voice = voice;

        setActive(button);
        utterance.onend = () => {
          if (activeButton === button) clearActive();
        };
        utterance.onerror = () => {
          if (activeButton === button) clearActive();
        };
        synth.speak(utterance);
      };

      const playStaticAudio = (button, text, audioUrl) => {
        const audio = new Audio(audioUrl);
        activeAudio = audio;
        setActive(button);
        let fallbackStarted = false;

        const fallback = () => {
          if (fallbackStarted || activeAudio !== audio) return;
          fallbackStarted = true;
          activeAudio = null;
          clearActive();
          speakFallback(button, text);
        };

        audio.addEventListener('ended', () => {
          if (activeAudio === audio) {
            activeAudio = null;
            clearActive();
          }
        }, { once: true });
        audio.addEventListener('error', fallback, { once: true });

        const result = audio.play();
        if (result && typeof result.catch === 'function') result.catch(fallback);
      };

      const manifestUrl = () => {
        const parts = window.location.pathname.split('/').filter(Boolean);
        const japaneseIndex = parts.lastIndexOf('japanese');
        const lessonId = japaneseIndex >= 0 ? parts[japaneseIndex + 1] : '';
        if (!lessonId) return null;
        const baseParts = parts.slice(0, japaneseIndex);
        const prefix = baseParts.length ? `/${baseParts.join('/')}` : '';
        return new URL(`${prefix}/audio/japanese/${encodeURIComponent(lessonId)}/manifest.json`, window.location.origin);
      };

      const attachAivisAudio = async () => {
        const url = manifestUrl();
        if (!url) return;
        try {
          const response = await fetch(url, { cache: 'no-cache' });
          if (!response.ok) return;
          const manifest = await response.json();
          const wordMap = new Map();
          const exampleMap = new Map();

          for (const item of manifest.items || []) {
            if (item.reading && item.word) wordMap.set(String(item.reading).trim(), new URL(item.word, url).href);
            if (item.term && item.word) wordMap.set(String(item.term).trim(), new URL(item.word, url).href);
            if (item.exampleJa && item.example) exampleMap.set(String(item.exampleJa).trim(), new URL(item.example, url).href);
          }

          buttons.forEach((button) => {
            if (!(button instanceof HTMLButtonElement)) return;
            const text = (button.dataset.speech || '').trim();
            const audio = button.dataset.speechKind === 'word' ? wordMap.get(text) : exampleMap.get(text);
            if (!audio) return;
            button.dataset.audio = audio;
            button.dataset.audioProvider = 'aivis';
            const voiceName = manifest.voice?.name || 'AivisSpeech';
            const styleName = manifest.voice?.style ? ` · ${manifest.voice.style}` : '';
            button.title = `AivisSpeech · ${voiceName}${styleName}`;
          });
        } catch {
          // No generated audio yet: keep browser TTS as the fallback.
        }
      };

      if (synth) {
        if (typeof synth.addEventListener === 'function') synth.addEventListener('voiceschanged', refreshVoices);
        else synth.onvoiceschanged = refreshVoices;
      }

      buttons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          const text = (button.dataset.speech || '').trim();
          if (!text) return;

          if (activeButton === button && button.getAttribute('aria-pressed') === 'true') {
            stopAll();
            return;
          }

          stopAll();
          const audioUrl = (button.dataset.audio || '').trim();
          if (audioUrl) playStaticAudio(button, text, audioUrl);
          else speakFallback(button, text);
        });
      });

      attachAivisAudio();
      window.addEventListener('pagehide', stopAll);
    })();
  </script>
</BaseLayout>
