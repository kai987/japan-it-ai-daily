---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getJapaneseLessonListDisplayTitle } from '../../lib/listDisplayTitles';

const base = import.meta.env.BASE_URL;
const root = `${base}ja/`;
const lessons = (await getCollection('japaneseJa')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const totalVocabulary = lessons.reduce((sum, lesson) => sum + lesson.data.vocabularyCount, 0);
const totalGrammar = lessons.reduce((sum, lesson) => sum + lesson.data.grammarCount, 0);
const levels = ['すべて', 'N5/N4', 'N3', 'N2', 'N1', 'IT/AI'];
---
<BaseLayout locale="ja" title="日本語学習 · Japan IT / AI Daily">
  <section class="hero">
    <div class="container">
      <div class="eyebrow">JLPT + IT日本語</div>
      <h1>日本語学習</h1>
      <p>毎日の推薦記事からJLPT語彙・文法とIT / AI専門表現を抽出。技術ニュースを読みながら、長期的に復習できる技術日本語の学習素材として蓄積します。</p>
      <div class="learning-stats" aria-label="日本語学習統計">
        <div><strong>{lessons.length}</strong><span>学習日</span></div>
        <div><strong>{totalVocabulary}</strong><span>語彙項目</span></div>
        <div><strong>{totalGrammar}</strong><span>文法項目</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-two">
      <a class="panel learning-entry" href="#lessons">
        <div class="entry-kicker">Vocabulary & Grammar</div>
        <h3>JLPT 語彙・文法 →</h3>
        <p>N5/N4、N3、N2、N1は学習上の参考レベルです。レベルごとに毎日の学習内容を絞り込めます。</p>
      </a>
      <a class="panel learning-entry" href={`?level=IT%2FAI#lessons`}>
        <div class="entry-kicker">Tech Japanese</div>
        <h3>IT / AI 日本語 →</h3>
        <p>MCP、RAG、Runtime、認証、認可、脆弱性、可観測性などの専門表現を日報テーマとともに継続して学びます。</p>
      </a>
    </div>
  </section>

  <section class="section" id="lessons" style="background:var(--surface)">
    <div class="container">
      <div class="section-title lesson-section-title">
        <div>
          <div class="eyebrow">Daily Japanese lessons</div>
          <h2>毎日の日本語学習</h2>
        </div>
        <span class="meta">JMdict/EDICTは読み・品詞・基本語義の確認に利用し、JLPTレベルは学習上の参考として扱います。</span>
      </div>

      <div class="level-filters" role="group" aria-label="JLPTレベルフィルター">
        {levels.map((level) => (
          <button class="level-filter" type="button" data-level-filter={level} aria-pressed={level === 'すべて' ? 'true' : 'false'}>{level}</button>
        ))}
      </div>

      <div class="lesson-list" id="lesson-list">
        {lessons.length ? lessons.map((lesson) => {
          const lessonLevels = ['N5/N4', ...lesson.data.levels];
          return (
            <a class="lesson-row" href={`${root}japanese/${lesson.id}/`} data-levels={lessonLevels.join('|')}>
              <div class="lesson-date">{lesson.data.date.toLocaleDateString('ja-JP')}</div>
              <div class="lesson-main">
                <h3>{getJapaneseLessonListDisplayTitle(lesson.data.date)}</h3>
                <p>{lesson.data.description}</p>
                <div class="tags compact-tags">
                  {lessonLevels.map((level:string) => <span class="tag">{level}</span>)}
                  {lesson.data.topics.slice(0,3).map((topic:string) => <span class="tag topic-tag">{topic}</span>)}
                </div>
              </div>
              <div class="lesson-counts">
                <span>{lesson.data.vocabularyCount} 語</span>
                <span>{lesson.data.grammarCount} 文法</span>
                <strong>学習 →</strong>
              </div>
            </a>
          );
        }) : (
          <div class="panel">日本語版の学習コンテンツを準備中です。</div>
        )}
      </div>

      <p class="lesson-empty" hidden>このレベルに該当する学習コンテンツはまだありません。</p>

      <nav class="lesson-pagination" aria-label="日本語学習ページ送り" hidden>
        <button class="lesson-pagination-nav lesson-pagination-prev" type="button" aria-label="前のページ">← 前へ</button>
        <div class="lesson-pagination-pages" aria-label="ページ番号"></div>
        <button class="lesson-pagination-nav lesson-pagination-next" type="button" aria-label="次のページ">次へ →</button>
        <div class="lesson-pagination-status" aria-live="polite"></div>
      </nav>
    </div>
  </section>

  <script>
    (() => {
      const PAGE_SIZE = 10;
      const buttons = Array.from(document.querySelectorAll('[data-level-filter]'));
      const rows = Array.from(document.querySelectorAll('[data-levels]')).filter((row) => row instanceof HTMLElement);
      const pagination = document.querySelector('.lesson-pagination');
      const pageContainer = document.querySelector('.lesson-pagination-pages');
      const prev = document.querySelector('.lesson-pagination-prev');
      const next = document.querySelector('.lesson-pagination-next');
      const status = document.querySelector('.lesson-pagination-status');
      const empty = document.querySelector('.lesson-empty');
      const lessonsSection = document.querySelector('#lessons');
      if (!buttons.length || !rows.length) return;

      const initialUrl = new URL(window.location.href);
      const allowedLevels = buttons.map((button) => button instanceof HTMLButtonElement ? button.dataset.levelFilter : '').filter(Boolean);
      const requestedLevel = initialUrl.searchParams.get('level') || 'すべて';
      let currentLevel = allowedLevels.includes(requestedLevel) ? requestedLevel : 'すべて';
      const requestedPage = Number.parseInt(initialUrl.searchParams.get('page') || '1', 10);
      let currentPage = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;

      const getFilteredRows = () => rows.filter((row) => {
        const rowLevels = (row.dataset.levels || '').split('|');
        return currentLevel === 'すべて' || rowLevels.includes(currentLevel);
      });

      const pageNumbers = (totalPages: number, page: number) => {
        if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);
        const values = new Set([1, totalPages, page - 1, page, page + 1]);
        return Array.from(values).filter((value) => value >= 1 && value <= totalPages).sort((a, b) => a - b);
      };

      const syncUrl = () => {
        const url = new URL(window.location.href);
        if (currentLevel === 'すべて') url.searchParams.delete('level');
        else url.searchParams.set('level', currentLevel);
        if (currentPage <= 1) url.searchParams.delete('page');
        else url.searchParams.set('page', String(currentPage));
        url.hash = 'lessons';
        history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
      };

      const scrollToLessons = () => {
        if (lessonsSection instanceof HTMLElement) lessonsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };

      const renderPagination = (filteredRows: HTMLElement[]) => {
        const totalItems = filteredRows.length;
        const totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
        currentPage = Math.min(Math.max(1, currentPage), totalPages);
        if (pagination instanceof HTMLElement) pagination.hidden = totalItems <= PAGE_SIZE;
        if (prev instanceof HTMLButtonElement) prev.disabled = currentPage <= 1;
        if (next instanceof HTMLButtonElement) next.disabled = currentPage >= totalPages;

        if (pageContainer instanceof HTMLElement) {
          pageContainer.replaceChildren();
          const pages = pageNumbers(totalPages, currentPage);
          let previousPage = 0;
          pages.forEach((page) => {
            if (previousPage && page - previousPage > 1) {
              const ellipsis = document.createElement('span');
              ellipsis.className = 'lesson-pagination-ellipsis';
              ellipsis.textContent = '…';
              ellipsis.setAttribute('aria-hidden', 'true');
              pageContainer.appendChild(ellipsis);
            }
            const pageButton = document.createElement('button');
            pageButton.type = 'button';
            pageButton.className = 'lesson-pagination-page';
            pageButton.textContent = String(page);
            pageButton.setAttribute('aria-label', `${page}ページ目`);
            if (page === currentPage) {
              pageButton.setAttribute('aria-current', 'page');
              pageButton.title = `現在のページ：${page}`;
            }
            pageButton.addEventListener('click', () => {
              if (page === currentPage) return;
              currentPage = page;
              render(true);
            });
            pageContainer.appendChild(pageButton);
            previousPage = page;
          });
        }

        if (status instanceof HTMLElement) {
          if (!totalItems) status.textContent = '';
          else {
            const start = (currentPage - 1) * PAGE_SIZE + 1;
            const end = Math.min(currentPage * PAGE_SIZE, totalItems);
            status.textContent = `${start}–${end} / ${totalItems}`;
          }
        }
      };

      const render = (shouldScroll = false) => {
        const filteredRows = getFilteredRows();
        const totalPages = Math.max(1, Math.ceil(filteredRows.length / PAGE_SIZE));
        currentPage = Math.min(Math.max(1, currentPage), totalPages);
        const pageStart = (currentPage - 1) * PAGE_SIZE;
        const visibleSet = new Set(filteredRows.slice(pageStart, pageStart + PAGE_SIZE));
        rows.forEach((row) => { row.hidden = !visibleSet.has(row); });
        buttons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          button.setAttribute('aria-pressed', button.dataset.levelFilter === currentLevel ? 'true' : 'false');
        });
        if (empty instanceof HTMLElement) empty.hidden = filteredRows.length !== 0;
        renderPagination(filteredRows);
        syncUrl();
        if (shouldScroll) scrollToLessons();
      };

      buttons.forEach((button) => button.addEventListener('click', () => {
        if (!(button instanceof HTMLButtonElement)) return;
        currentLevel = button.dataset.levelFilter || 'すべて';
        currentPage = 1;
        render(false);
      }));
      if (prev instanceof HTMLButtonElement) prev.addEventListener('click', () => {
        if (currentPage <= 1) return;
        currentPage -= 1;
        render(true);
      });
      if (next instanceof HTMLButtonElement) next.addEventListener('click', () => {
        const totalPages = Math.ceil(getFilteredRows().length / PAGE_SIZE);
        if (currentPage >= totalPages) return;
        currentPage += 1;
        render(true);
      });
      render(false);
    })();
  </script>

  <style>
    .lesson-section-title{scroll-margin-top:92px}
    .lesson-empty{padding:36px 0;text-align:center;color:var(--muted)}
    .lesson-pagination{display:grid;grid-template-columns:auto minmax(0,1fr) auto;grid-template-areas:"prev pages next" "status status status";align-items:center;gap:12px;margin-top:30px;padding-top:22px;border-top:1px solid var(--border)}
    .lesson-pagination[hidden]{display:none}
    .lesson-pagination-prev{grid-area:prev}.lesson-pagination-pages{grid-area:pages}.lesson-pagination-next{grid-area:next}.lesson-pagination-status{grid-area:status}
    .lesson-pagination-pages{display:flex;align-items:center;justify-content:center;gap:6px;min-width:0}
    .lesson-pagination-nav,.lesson-pagination-page{border:1px solid var(--border);background:var(--surface-elevated);color:var(--subtle-text);cursor:pointer;font-weight:700;transition:.16s ease}
    .lesson-pagination-nav{min-height:40px;border-radius:10px;padding:8px 13px;font-size:.82rem;white-space:nowrap}
    .lesson-pagination-page{width:40px;height:40px;border-radius:10px;padding:0;font-size:.84rem}
    .lesson-pagination-nav:hover:not(:disabled),.lesson-pagination-page:hover{border-color:var(--accent);color:var(--accent)}
    .lesson-pagination-page[aria-current='page']{border-color:var(--accent);background:var(--accent);color:#fff;box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 14%,transparent)}
    .lesson-pagination-page[aria-current='page']:hover{color:#fff}
    .lesson-pagination-nav:disabled{opacity:.38;cursor:not-allowed}
    .lesson-pagination-ellipsis{display:inline-grid;place-items:center;width:24px;color:var(--muted)}
    .lesson-pagination-status{text-align:center;color:var(--muted);font-size:.78rem;font-variant-numeric:tabular-nums}
    @media(max-width:700px){
      .lesson-pagination{grid-template-columns:1fr 1fr;grid-template-areas:"prev next" "pages pages" "status status";gap:10px}
      .lesson-pagination-pages{overflow-x:auto;justify-content:flex-start;padding-bottom:2px;scrollbar-width:none}
      .lesson-pagination-pages::-webkit-scrollbar{display:none}
      .lesson-pagination-prev,.lesson-pagination-next{width:100%}
      .lesson-pagination-page{flex:0 0 38px;width:38px;height:38px}
    }
  </style>
</BaseLayout>
