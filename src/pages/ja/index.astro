---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { featuredTopics, countTopicArticles } from '../../lib/topics';
import { getJapaneseArticleTitle } from '../../lib/articleTitles';
import { getSafeExternalUrl } from '../../lib/urls';

const base = import.meta.env.BASE_URL;
const root = `${base}ja/`;
const reports = (await getCollection('dailyJa')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = reports[0];
const recent = reports.slice(0, 6);
const top = latest?.data.top ?? [];
const topicStats = featuredTopics.map((topic) => ({
  ...topic,
  count: countTopicArticles(reports, topic),
}));
---
<BaseLayout locale="ja" title="Japan IT / AI Daily">
  <section class="hero home-hero">
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <div class="eyebrow">Daily report · 日本時間</div>
        <h1>日本 IT / AI 日報</h1>
        <p>日本のIT・AI技術ニュースを、AIエンジニア面接と技術日本語の視点から毎日整理。記事を読むだけでなく、知識として残し、面接で説明できるところまでまとめます。</p>
        <div class="tags">
          <span class="tag">AI Agent</span><span class="tag">MCP</span><span class="tag">RAG</span><span class="tag">Security</span><span class="tag">React / Next.js</span><span class="tag">Cloud</span>
        </div>
      </div>

      <aside class="topic-explorer" aria-label="トピックから探す">
        <div class="topic-explorer-heading">
          <div>
            <div class="eyebrow">EXPLORE TOPICS</div>
            <h2>テーマから探す</h2>
          </div>
          <a href={`${root}topics/`}>すべてのテーマ →</a>
        </div>
        <div class="topic-mini-grid">
          {topicStats.map((topic) => (
            <a class="topic-mini-card" href={`${root}topics/${topic.key}/`}>
              <strong>{topic.label}</strong>
              <span>{topic.count} 記事</span>
              <small>見る →</small>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>今日読むべき5本</h2>
        {latest && <a href={`${root}daily/${latest.id}/`}>日報全文を読む →</a>}
      </div>
      {top.length ? (
        <div class="top-list">
          {top.slice(0,5).map((item:any, i:number) => {
            const displayTitle = getJapaneseArticleTitle(item);
            const safeUrl = getSafeExternalUrl(item.url);
            const story = (
              <>
                <div class="rank">{String(i+1).padStart(2,'0')}</div>
                <div>
                  <h3>{displayTitle}</h3>
                  <div class="meta">{item.source}{item.topic ? ` · ${item.topic}` : ''}</div>
                  {item.why && <div class="why">{item.why}</div>}
                </div>
                <div class="story-side">
                  <div class="date">{latest.data.date.toLocaleDateString('ja-JP')}</div>
                  {safeUrl && <div class="external-label">原文 ↗</div>}
                </div>
              </>
            );
            return safeUrl ? (
              <a class="top-item top-item-link" href={safeUrl} target="_blank" rel="noopener noreferrer" aria-label={`${displayTitle}（原文を新しいタブで開く）`}>
                {story}
              </a>
            ) : (
              <article class="top-item">{story}</article>
            );
          })}
        </div>
      ) : (
        <div class="panel">最初の日報が公開されると、ここに当日のTop 5が表示されます。</div>
      )}
    </div>
  </section>

  <section class="section" style="background:var(--surface)">
    <div class="container grid-two">
      <a class="panel" href={`${root}knowledge/`}>
        <h3>B. 重要ポイント</h3>
        <p>当日のTop 5から、復習や面接で使いやすい技術知識だけを整理します。</p>
      </a>
      <a class="panel" href={`${root}japanese/`}>
        <h3>C. 日本語学習｜JLPT + IT日本語</h3>
        <p>当日の記事からJLPT語彙・文法とIT / AI専門表現を抽出し、レベル別に整理します。</p>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title"><h2>最近の日報</h2><a href={`${root}archive/`}>すべてのアーカイブ →</a></div>
      <div class="archive-list">
        {recent.map((report) => (
          <a class="archive-row" href={`${root}daily/${report.id}/`}>
            <div class="meta">{report.data.date.toLocaleDateString('ja-JP')}</div>
            <div><strong>{report.data.title}</strong><div class="meta">{report.data.description}</div></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
